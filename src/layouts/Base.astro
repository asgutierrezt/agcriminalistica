---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { SITE } from '../data/site';
import { organizationSchema, websiteSchema } from '../lib/schema';
import defaultOg from '../assets/img/ciencias-forenses-laboratorio.jpg';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  serif?: boolean;
}

const {
  title,
  description,
  image = defaultOg,
  imageAlt = 'AG Criminalística, capacitación en ciencias forenses',
  type = 'website',
  published,
  modified,
  schema = [],
  noindex = false,
  serif = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
// Append the brand only while the title stays within what Google displays (~60 chars).
const branded = `${title} | AG Criminalística`;
const fullTitle = title.includes('AG Criminalística') || branded.length > 62 ? title : branded;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema, websiteSchema, ...schema],
};
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#08131f" />
    <meta name="author" content={SITE.legalName} />

    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    {serif && <link rel="preload" href="/fonts/source-serif.woff2" as="font" type="font/woff2" crossorigin />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Blog AG Criminalística" href="/feed.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
    <script>
      // Reveal-on-scroll; elements stay visible if JS or IntersectionObserver is missing.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

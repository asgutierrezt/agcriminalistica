---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV } from '../data/nav';
import { whatsappLink } from '../data/site';

const path = Astro.url.pathname;
// Longest matching prefix wins, so "Reconstrucción 3D" is active instead of "Servicios".
// Resource pages (glossary, manuals) also activate their parent menu item.
const owner = (h: string) => NAV.find((n) => n.href === h || n.children?.some((c) => c.href === h))?.href ?? h;
const active = NAV.flatMap((n) => [n.href, ...(n.children?.map((c) => c.href) ?? [])])
  .filter((h) => (h === '/' ? path === '/' : path.startsWith(h)))
  .sort((a, b) => b.length - a.length)[0];
const isActive = (href: string) => active !== undefined && owner(active) === href;
---
<header class="site-header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label="AG Criminalística, ir al inicio">
      <Logo size={38} />
    </a>

    <nav class="desktop-nav" aria-label="Principal">
      <ul data-nav>
        {NAV.map((item) => (
          <li class:list={{ 'has-sub': !!item.children }}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} aria-haspopup={item.children ? 'true' : undefined}>
              <span class="t" data-scramble>{item.label}</span>{item.children && <span class="caret" aria-hidden="true">▾</span>}
            </a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => (
                  <li><a href={c.href}><strong>{c.label}</strong>{c.desc && <small>{c.desc}</small>}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
        <li class="ink-line" aria-hidden="true" data-ink></li>
      </ul>
    </nav>

    <a class="btn btn-primary header-cta" href="/contacto/">Solicitar peritaje</a>

    <button class="menu-btn" popovertarget="mobile-menu" aria-label="Abrir menú">
      <Icon name="menu" size={26} />
    </button>
  </div>

  <div id="mobile-menu" popover class="mobile-menu">
    <div class="mobile-top">
      <Logo size={36} />
      <button class="menu-btn close" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Cerrar menú">
        <Icon name="close" size={26} />
      </button>
    </div>
    <nav aria-label="Menú móvil">
      <ol>
        {NAV.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
            {item.children && (
              <ul class="m-sub">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>
    <p class="m-foot" aria-hidden="true"><span class="dot"></span>Peritaje criminalístico · Todo Ecuador</p>
    <div class="mobile-actions">
      <a class="btn btn-primary" href="/contacto/">Solicitar peritaje</a>
      <a class="btn btn-ghost" href={whatsappLink()} rel="noopener" target="_blank">
        <Icon name="whatsapp" /> WhatsApp
      </a>
    </div>
  </div>
  <div class="progress" aria-hidden="true"></div>
</header>

<script>
  // Header polish (desktop + mobile):
  //  · a shadow once the page scrolls;
  //  · a sliding line under the hovered menu item, resting on the current page;
  //  · a short "decode" effect on the hovered label.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (header) {
    let scrolled = false;
    const onScroll = () => {
      const s = scrollY > 8;
      if (s !== scrolled) header.classList.toggle('scrolled', (scrolled = s));
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const nav = header.querySelector<HTMLElement>('[data-nav]');
    const ink = header.querySelector<HTMLElement>('[data-ink]');
    if (nav && ink && matchMedia('(hover: hover)').matches) {
      const links = [...nav.querySelectorAll<HTMLAnchorElement>(':scope > li > a')];
      const current = links.find((a) => a.getAttribute('aria-current') === 'page');
      const moveTo = (a?: HTMLElement) => {
        if (!a) return void ink.classList.remove('on');
        const n = nav.getBoundingClientRect();
        const r = a.getBoundingClientRect();
        ink.style.transform = `translateX(${r.left - n.left + 10}px) scaleX(${(r.width - 20) / 100})`;
        ink.classList.add('on');
      };
      requestAnimationFrame(() => moveTo(current));
      links.forEach((a) => a.addEventListener('mouseenter', () => moveTo(a)));
      nav.addEventListener('mouseleave', () => moveTo(current));
      addEventListener('resize', () => moveTo(current), { passive: true });
    }

    if (!reduce && matchMedia('(hover: hover)').matches) {
      const GLYPHS = 'abcdefghijklmnopqrstuvwxyz0123456789';
      for (const el of header.querySelectorAll<HTMLElement>('[data-scramble]')) {
        const text = el.textContent ?? '';
        let raf = 0;
        el.closest('a')!.addEventListener('mouseenter', () => {
          cancelAnimationFrame(raf);
          el.style.width = `${el.offsetWidth}px`; // the random letters must not shift the menu
          const start = performance.now();
          const step = (now: number) => {
            const done = Math.floor((now - start) / 28); // letters resolved so far
            el.textContent = [...text]
              .map((ch, i) => (i < done || ch === ' ' ? ch : GLYPHS[(Math.random() * GLYPHS.length) | 0]))
              .join('');
            if (done < text.length) raf = requestAnimationFrame(step);
            else {
              el.textContent = text;
              el.style.width = '';
            }
          };
          raf = requestAnimationFrame(step);
        });
      }
    }
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(14, 16, 19, 0.88);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    color: var(--white);
    border-bottom: 1px solid var(--line-on-ink);
    transition: box-shadow 0.3s ease, background-color 0.3s ease;
  }
  .site-header.scrolled { background: rgba(14, 16, 19, 0.94); box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.9); }
  /* Reading progress of the whole page, along the bottom edge (CSS only, where supported). */
  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, var(--cyan), var(--amber)); }
  @supports (animation-timeline: scroll()) {
    .progress { animation: progress linear both; animation-timeline: scroll(root); }
  }
  @keyframes progress { to { transform: scaleX(1); } }
  .bar { display: flex; align-items: center; gap: 1rem; height: var(--header-h); }
  .brand { text-decoration: none; margin-right: auto; }
  .desktop-nav { display: none; }
  .desktop-nav ul { display: flex; gap: 0.25rem; list-style: none; padding: 0; }
  .desktop-nav > ul { position: relative; }
  /* Sliding line under the hovered item (positioned by the script). */
  .ink-line {
    position: absolute; left: 0; bottom: -2px; width: 100px; height: 2px; border-radius: 2px; pointer-events: none;
    background: var(--cyan); box-shadow: 0 0 12px rgba(212, 185, 121, 0.8); transform-origin: left;
    opacity: 0; transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s ease;
  }
  .ink-line.on { opacity: 1; }
  .desktop-nav .t { display: inline-block; white-space: nowrap; overflow: hidden; vertical-align: bottom; }
  .desktop-nav a {
    display: block; padding: 0.5rem 0.65rem; border-radius: 8px;
    text-decoration: none; font-weight: 600; font-size: 0.95rem; color: var(--muted-on-ink);
  }
  .desktop-nav a:hover { color: var(--white); background: rgba(255,255,255,0.06); }
  .desktop-nav a[aria-current='page'] { color: var(--white); }
  .has-sub { position: relative; }
  .caret { font-size: 0.7em; margin-left: 0.3rem; opacity: 0.7; }
  .sub {
    position: absolute; top: calc(100% + 6px); left: -0.5rem; min-width: 270px; padding: 0.5rem !important;
    display: grid !important; gap: 0.15rem !important; border-radius: 14px;
    background: var(--ink-2); border: 1px solid var(--line-on-ink); box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.7);
    opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  .sub::before { content: ''; position: absolute; left: 0; right: 0; top: -10px; height: 10px; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { display: grid !important; gap: 0.1rem; padding: 0.6rem 0.75rem !important; border-radius: 10px !important; box-shadow: none !important; }
  .sub strong { color: var(--white); font-size: 0.93rem; }
  .sub small { color: var(--muted-on-ink); font-weight: 400; font-size: 0.8rem; }
  .header-cta { display: none; min-height: 44px; padding: 0.5rem 1.1rem; font-size: 0.92rem; }
  .menu-btn {
    display: grid; place-items: center; width: 48px; height: 48px;
    background: transparent; border: 1px solid var(--line-on-ink); border-radius: 12px; cursor: pointer; color: inherit;
  }
  @media (min-width: 1180px) {
    .desktop-nav { display: block; }
    .header-cta { display: inline-flex; }
    .menu-btn { display: none; }
  }

  .mobile-menu {
    position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none;
    margin: 0; border: 0; padding: 1rem var(--gutter) 2rem;
    background: var(--ink); color: var(--white);
    flex-direction: column; gap: 1.5rem; overflow-y: auto;
  }
  /* Opens as a circle growing from the menu button; the items then rise in one by one. */
  .mobile-menu:popover-open { display: flex; animation: menu-in 0.45s cubic-bezier(0.7, 0, 0.2, 1); }
  @keyframes menu-in { from { clip-path: circle(0 at calc(100% - var(--gutter) - 24px) 32px); } to { clip-path: circle(150% at calc(100% - var(--gutter) - 24px) 32px); } }
  .mobile-menu:popover-open ol > li { animation: item-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(0.18s + var(--i) * 0.05s); }
  .mobile-menu:popover-open .mobile-actions, .mobile-menu:popover-open .m-foot { animation: item-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s both; }
  @keyframes item-in { from { opacity: 0; transform: translateY(18px); } }
  .mobile-menu {
    background:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      radial-gradient(120% 60% at 100% 0%, rgba(212, 185, 121, 0.16), transparent 60%),
      var(--ink);
  }
  .m-foot { display: flex; align-items: center; gap: 0.6rem; margin: 0; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-on-ink); }
  .m-foot .dot { width: 8px; height: 8px; border-radius: 50%; background: #2bd576; box-shadow: 0 0 0 4px rgba(43, 213, 118, 0.18); }
  .mobile-top { display: flex; align-items: center; justify-content: space-between; height: 48px; }
  .mobile-menu ol { list-style: none; padding: 0; border-top: 1px solid var(--line-on-ink); }
  .mobile-menu li { border-bottom: 1px solid var(--line-on-ink); }
  .mobile-menu ol a {
    display: flex; align-items: baseline; gap: 1rem; padding: 0.85rem 0;
    font-size: 1.55rem; font-weight: 800; letter-spacing: -0.02em; text-decoration: none;
  }
  .mobile-menu ol a[aria-current='page'] { color: var(--cyan); }
  .mobile-menu ol a:active { color: var(--amber); }
  .m-sub { list-style: none; padding: 0 0 0.8rem 2.2rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .mobile-menu .m-sub li { border: 0; }
  .mobile-menu .m-sub a { display: inline-flex; padding: 0.45rem 0.8rem; border-radius: 999px; border: 1px solid var(--line-on-ink); text-decoration: none; font-size: 0.92rem; font-weight: 600; color: var(--muted-on-ink); }
  .idx { font-family: var(--font-mono); font-size: 0.8rem; color: var(--amber); font-weight: 600; }
  .mobile-actions { display: grid; gap: 0.75rem; margin-top: auto; }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu:popover-open, .mobile-menu:popover-open ol > li, .mobile-menu:popover-open .mobile-actions, .mobile-menu:popover-open .m-foot { animation: none; }
    .ink-line { transition: none; }
  }
</style>

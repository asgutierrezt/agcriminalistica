---
/**
 * "Forensic UV light", site-wide: with a mouse, latent fingerprints glow where
 * the cursor passes over any dark (.ink) section, like a forensic lamp
 * revealing prints. Rendered once per page as a <template>; the layer is only
 * cloned into a section the first time the mouse enters it. Pointer-only and
 * purely decorative: touch screens never load or see it.
 */
import Fingerprint from './Fingerprint.astro';

const prints = [
  { x: '5%', y: '12%', w: 170, r: -18 },
  { x: '30%', y: '62%', w: 130, r: 24 },
  { x: '50%', y: '4%', w: 150, r: 8 },
  { x: '74%', y: '58%', w: 190, r: -30 },
  { x: '88%', y: '8%', w: 115, r: 40 },
  { x: '15%', y: '80%', w: 140, r: -4 },
];
---
<template id="uv-layer">
  <div class="uv" aria-hidden="true">
    {prints.map((p) => (
      <span style={`left:${p.x};top:${p.y};width:${p.w}px;transform:rotate(${p.r}deg)`}><Fingerprint /></span>
    ))}
  </div>
</template>

<script>
  const tpl = document.querySelector<HTMLTemplateElement>('#uv-layer');
  if (tpl && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const HOSTS = 'section.ink, header.ink, footer.ink, .page-hero';
    for (const host of document.querySelectorAll<HTMLElement>(HOSTS)) {
      if (host.closest('[data-tour]')) continue;
      let uv: HTMLElement | null = null;
      let raf = 0;
      let x = 0;
      let y = 0;
      host.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        x = e.clientX;
        y = e.clientY;
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          if (!uv) {
            uv = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
            host.classList.add('uv-host');
            if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
            host.prepend(uv);
          }
          const r = host.getBoundingClientRect();
          uv.style.setProperty('--x', `${x - r.left}px`);
          uv.style.setProperty('--y', `${y - r.top}px`);
          uv.classList.add('on');
        });
      }, { passive: true });
      host.addEventListener('pointerleave', () => uv?.classList.remove('on'));
    }
  }
</script>

<style is:global>
  /* The layer sits above the section background and below its content. */
  .uv-host { isolation: isolate; }
  .uv {
    position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0; transition: opacity 0.35s ease; overflow: hidden;
    color: #cbb6ff;
    background: radial-gradient(circle 230px at var(--x, 50%) var(--y, 50%), rgba(132, 92, 255, 0.24), transparent 70%);
    -webkit-mask-image: radial-gradient(circle 230px at var(--x, 50%) var(--y, 50%), #000 35%, transparent 100%);
    mask-image: radial-gradient(circle 230px at var(--x, 50%) var(--y, 50%), #000 35%, transparent 100%);
  }
  .uv.on { opacity: 1; }
  .uv > span { position: absolute; opacity: 0.85; filter: drop-shadow(0 0 6px rgba(160, 120, 255, 0.8)); }
  @media (prefers-reduced-motion: reduce) { .uv { transition: none; } }
</style>

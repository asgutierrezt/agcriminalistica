---
import { AFFILIATE_DISCLOSURE } from '../data/affiliate';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<p class:list={['aff-note', cls]}>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 11v5M12 8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  <span>{AFFILIATE_DISCLOSURE}</span>
</p>

<style>
  .aff-note {
    display: flex; gap: 0.6rem; align-items: flex-start; padding: 0.75rem 1rem; border-radius: 12px;
    background: rgba(245, 183, 10, 0.12); border: 1px solid rgba(245, 183, 10, 0.45);
    font-size: 0.86rem; line-height: 1.45; color: inherit;
  }
  .aff-note svg { flex: none; margin-top: 1px; color: #a87a00; }
</style>

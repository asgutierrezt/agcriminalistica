---
// Thin progress bar under the header showing how much of the article has been read.
---
<div class="rp" aria-hidden="true"><span data-rp></span></div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-rp]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  if (bar && article) {
    let queued = false;
    const update = () => {
      queued = false;
      const r = article.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, -r.top / Math.max(total, 1)));
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>

<style>
  .rp { position: fixed; top: var(--header-h); left: 0; right: 0; height: 3px; z-index: 49; pointer-events: none; }
  .rp span { display: block; height: 100%; background: linear-gradient(90deg, var(--cyan), var(--amber)); transform-origin: 0 50%; transform: scaleX(0); }
</style>

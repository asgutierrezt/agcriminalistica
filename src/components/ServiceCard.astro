---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Service } from '../lib/utils';
interface Props { service: Service; headingLevel?: 2 | 3; featured?: boolean }
const { service, headingLevel = 3, featured = false } = Astro.props;
const { shortTitle, tagline, cover, icon, code, useCases } = service.data;
const H = `h${headingLevel}` as 'h2' | 'h3';
const href = `/servicios/${service.id}/`;
---
<article class:list={['svc reveal', { featured }]}>
  <div class="media">
    <Image src={cover} alt="" widths={[420, 640, 900]} sizes="(min-width: 1040px) 400px, (min-width: 720px) 45vw, 92vw" class="img" />
    <span class="tag">{code} · INDICIO</span>
  </div>
  <div class="body">
    <span class="ic"><Icon name={icon} size={26} /></span>
    <H class="title"><a href={href}>{shortTitle}</a></H>
    <p class="tagline">{tagline}</p>
    <ul>{useCases.slice(0, 3).map((u) => <li>{u}</li>)}</ul>
    <span class="more">Ver servicio <Icon name="arrow" size={18} /></span>
  </div>
</article>

<style>
  .svc {
    position: relative; display: grid; grid-template-rows: auto 1fr;
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .svc:hover { transform: translateY(-4px); border-color: var(--cyan); box-shadow: 0 24px 50px -30px rgba(8, 19, 31, 0.45); }
  .media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--ink); }
  .img { width: 100%; height: 100%; object-fit: cover; }
  .media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(8, 19, 31, 0.55)); }
  .tag {
    position: absolute; left: 12px; bottom: 12px; z-index: 1;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.12em;
    background: var(--amber); color: var(--ink); padding: 0.3rem 0.55rem; border-radius: 4px;
  }
  .body { position: relative; display: flex; flex-direction: column; gap: 0.7rem; padding: 2.2rem 1.4rem 1.5rem; }
  .ic {
    position: absolute; top: -28px; right: 1.2rem; display: grid; place-items: center; width: 56px; height: 56px;
    border-radius: 14px; background: var(--ink); color: var(--cyan); border: 3px solid var(--white);
  }
  .title { font-size: 1.45rem; }
  .title a { text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .tagline { color: var(--muted); font-size: 0.97rem; }
  ul { list-style: none; padding: 0; display: grid; gap: 0.35rem; font-size: 0.9rem; }
  li { display: flex; gap: 0.5rem; align-items: baseline; }
  li::before { content: ''; width: 7px; height: 7px; flex: none; background: var(--cyan); transform: rotate(45deg) translateY(-1px); }
  .more { margin-top: auto; padding-top: 0.4rem; display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--cyan-ink); }
  .featured { border-color: var(--ink); }
</style>

---
import { amazonLink, AFFILIATE_REL } from '../data/affiliate';
import type { LibraryItem } from '../data/library';
interface Props { item: LibraryItem; compact?: boolean }
const { item, compact = false } = Astro.props;
const isBook = item.cat !== 'equipo';
const initials = item.title.replace(/^(Libros (de|sobre) |Kit de |La |El )/i, '').slice(0, 2).toUpperCase();
---
<article class:list={['lib', { compact }]} data-lib={item.cat}>
  {item.image ? (
    <a class="cover" href={amazonLink(item)} rel={AFFILIATE_REL} target="_blank" tabindex="-1" aria-hidden="true">
      <img src={item.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer-when-downgrade" />
    </a>
  ) : (
    <div class:list={['spine', item.cat]} aria-hidden="true">
      {isBook ? <span class="spine-t">{initials}</span> : <span class="spine-t">⚲</span>}
      <span class="spine-cat">{item.topic}</span>
    </div>
  )}
  <div class="body">
    {item.level && <p class="meta">{item.level} · {item.cat === 'en' ? 'Inglés' : item.cat === 'es' ? 'Español' : 'Equipo'}{item.format && ` · ${item.format}`}</p>}
    {!item.level && <p class="meta">{item.cat === 'equipo' ? 'Equipo' : 'Selección'}</p>}
    <h3>{item.title}</h3>
    {item.author && <p class="author">{item.author}</p>}
    {!compact && <p class="why">{item.why}</p>}
    <div class="actions">
      <a class="btn-amz" href={amazonLink(item)} rel={AFFILIATE_REL} target="_blank">
        Ver en Amazon <span aria-hidden="true">↗</span>
      </a>
      {item.kindle && (
        <a class="btn-kindle" href={amazonLink({ asin: item.kindle })} rel={AFFILIATE_REL} target="_blank" title="Sin envío: se descarga al instante">
          Versión Kindle
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .lib {
    display: grid; grid-template-columns: 92px 1fr; gap: 1rem; padding: 1rem; border-radius: var(--radius);
    background: var(--white); border: 1px solid var(--line); transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .lib:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .cover { display: grid; place-items: center; aspect-ratio: 2 / 3; background: var(--white); border-radius: 6px; overflow: hidden; }
  .cover img { width: 100%; height: 100%; object-fit: contain; }
  .spine {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start;
    aspect-ratio: 2 / 3; padding: 0.6rem; border-radius: 4px 10px 10px 4px; color: var(--white); overflow: hidden;
    background: linear-gradient(135deg, var(--ink-3), var(--ink));
    box-shadow: inset 6px 0 0 rgba(255, 255, 255, 0.08), 0 10px 20px -12px rgba(8, 19, 31, 0.7);
  }
  .spine.en { background: linear-gradient(135deg, #2c5c80, #0f2133); }
  .spine.equipo { background: linear-gradient(135deg, #3b3320, #1b1708); aspect-ratio: 1; border-radius: 12px; }
  .spine::after { content: ''; position: absolute; left: 0; right: 0; top: 38%; height: 3px; background: var(--amber); opacity: 0.85; }
  .spine-t { font-weight: 900; font-size: 1.5rem; letter-spacing: -0.03em; }
  .spine-cat { font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--amber); line-height: 1.2; }
  .body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .meta { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cyan-ink); font-weight: 700; }
  h3 { font-size: 1.05rem; line-height: 1.25; }
  .author { font-size: 0.88rem; color: var(--muted); }
  .why { font-size: 0.9rem; color: #33414e; }
  .actions { margin-top: auto; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .btn-kindle {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0.45rem 0.9rem; border-radius: 999px;
    text-decoration: none; font-weight: 700; font-size: 0.85rem; border: 1.5px solid var(--ink); color: var(--ink);
  }
  .btn-kindle:hover { background: var(--ink); color: var(--white); }
  .btn-amz {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 0.35rem;
    min-height: 40px; padding: 0.45rem 0.9rem; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: 0.88rem;
    background: var(--amber); color: var(--ink);
  }
  .btn-amz:hover { background: #ffc933; }
  .compact { grid-template-columns: 64px 1fr; padding: 0.8rem; }
  .compact .spine-t { font-size: 1.1rem; }
  .compact .spine-cat { display: none; }
</style>

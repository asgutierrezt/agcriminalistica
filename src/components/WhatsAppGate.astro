---
/**
 * Short question shown before WhatsApp opens, so people looking for a public
 * office (Fiscalía, Policía, Judicatura…) go to /informacion-util/ instead of
 * writing. Built only on the first click (no markup or link in the page, so
 * /informacion-util/ stays out of the site navigation). Once someone chooses
 * "servicio", it is not shown again on that device for 30 days.
 */
import { SITE } from '../data/site';
const waPrefix = SITE.whatsapp; // https://wa.me/<number>; share links (wa.me/?text=) are not gated
---
<script is:inline define:vars={{ waPrefix }}>
  (() => {
    const KEY = 'ag-wa-ok';
    const DAYS = 30;
    const remembered = () => {
      try {
        const t = Number(localStorage.getItem(KEY));
        return t > 0 && Date.now() - t < DAYS * 864e5;
      } catch {
        return false;
      }
    };
    const remember = () => {
      try {
        localStorage.setItem(KEY, String(Date.now()));
      } catch {}
    };
    const go = (a) => {
      if (a.target === '_blank') window.open(a.href, '_blank', 'noopener');
      else location.assign(a.href);
    };

    let dlg = null;
    let pending = null;
    const build = () => {
      dlg = document.createElement('dialog');
      dlg.className = 'wag';
      dlg.setAttribute('aria-labelledby', 'wag-t');
      dlg.innerHTML = `
        <div class="wag-card">
          <button type="button" class="wag-x" data-wag="close" aria-label="Cerrar">×</button>
          <p class="wag-kicker">WhatsApp · AG Criminalística</p>
          <h2 id="wag-t">¿En qué podemos ayudarte?</h2>
          <p class="wag-lead">Somos una empresa privada de servicios periciales. No realizamos trámites de instituciones públicas.</p>
          <button type="button" class="wag-opt wag-main" data-wag="go">
            <span class="wag-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"/></svg></span>
            <span class="wag-txt"><strong>Necesito un servicio pericial</strong><small>Peritaje, reconstrucción 3D o asesoría técnica</small></span>
            <span class="wag-arrow" aria-hidden="true">→</span>
          </button>
          <a class="wag-opt wag-alt" href="/informacion-util/" data-wag="info">
            <span class="wag-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10 12 4l9 6M5 10v9M9.5 10v9M14.5 10v9M19 10v9M3 21h18"/></svg></span>
            <span class="wag-txt"><strong>Busco una institución pública</strong><small>Fiscalía, Policía, Judicatura, antecedentes penales…</small></span>
            <span class="wag-arrow" aria-hidden="true">→</span>
          </a>
        </div>`;
      dlg.addEventListener('click', (e) => {
        const t = e.target;
        if (t === dlg) return dlg.close(); // click on the backdrop
        const action = t.closest('[data-wag]')?.dataset.wag;
        if (action === 'close') dlg.close();
        if (action === 'go' && pending) {
          remember();
          dlg.close();
          go(pending);
        }
      });
      document.body.append(dlg);
    };

    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = e.target.closest?.('a[href]');
      if (!a || !a.href.startsWith(waPrefix) || remembered() || typeof HTMLDialogElement !== 'function') return;
      e.preventDefault();
      pending = a;
      if (!dlg) build();
      dlg.showModal();
      dlg.querySelector('.wag-main').focus();
    });
  })();
</script>

<style is:global>
  .wag {
    width: min(100% - 24px, 440px); max-width: none; max-height: none; margin: auto auto 12px; padding: 0; border: 0; background: transparent; color: var(--text);
    overflow: visible;
  }
  @media (min-width: 640px) { .wag { margin: auto; } }
  .wag::backdrop { background: rgba(14, 16, 19, 0.55); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
  .wag[open] .wag-card { animation: wag-in 0.22s ease-out; }
  @keyframes wag-in { from { opacity: 0; transform: translateY(14px); } }
  @media (prefers-reduced-motion: reduce) { .wag[open] .wag-card { animation: none; } }
  .wag-card {
    position: relative; display: grid; gap: 0.7rem; padding: 1.4rem 1.25rem 1.25rem; border-radius: 20px;
    background: var(--white); box-shadow: 0 30px 70px -20px rgba(14, 16, 19, 0.55); font-family: var(--font-sans);
  }
  .wag-kicker { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cyan-ink); }
  .wag h2 { font-size: 1.35rem; line-height: 1.2; padding-right: 2rem; }
  .wag-lead { font-size: 0.93rem; color: var(--muted); margin-bottom: 0.2rem; }
  .wag-x {
    position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--paper-2); color: var(--text); font-size: 1.3rem; line-height: 1;
  }
  .wag-opt {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.8rem; width: 100%; padding: 0.85rem 1rem; border-radius: 14px;
    text-align: left; text-decoration: none; cursor: pointer; font: inherit; transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .wag-main { border: 0; background: #25d366; color: #062b14; }
  .wag-main:hover { background: #2fe072; }
  .wag-alt { border: 1.5px solid var(--line); background: var(--white); color: var(--text); }
  .wag-alt:hover { border-color: var(--cyan); }
  .wag-ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: rgba(255, 255, 255, 0.35); }
  .wag-alt .wag-ico { background: var(--paper-2); color: var(--steel); }
  .wag-txt { display: grid; gap: 0.1rem; min-width: 0; }
  .wag-txt strong { font-size: 0.98rem; }
  .wag-txt small { font-size: 0.8rem; opacity: 0.8; }
  .wag-arrow { font-weight: 800; }
  .wag-opt:focus-visible, .wag-x:focus-visible { outline: 3px solid var(--cyan); outline-offset: 2px; }
</style>

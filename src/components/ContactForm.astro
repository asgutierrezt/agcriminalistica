---
import Icon from './Icon.astro';
import { SITE } from '../data/site';

const thanks = new URL('/contacto/gracias/', SITE.url).href;
// `key` matches the ?interes= query parameter used by CTA buttons across the site.
const topics = [
  { key: 'reconstruccion-3d', label: 'Reconstrucción 3D de los hechos' },
  { key: 'peritaje', label: 'Peritaje criminalístico' },
  { key: 'consultoria', label: 'Consultoría pericial para abogados' },
  { key: 'criminalistica', label: 'Curso: Criminalística (formación de peritos)' },
  { key: 'informatica-forense', label: 'Curso: Informática forense' },
  { key: 'investigacion-del-crimen', label: 'Curso: Investigación del crimen' },
  { key: 'manual-dactiloscopia', label: 'Manual de dactiloscopia' },
  { key: 'manual-voz', label: 'Manual de identificación forense de la voz' },
  { key: 'otro', label: 'Otro tema' },
];
const caseTypes = ['Penal', 'Civil', 'Tránsito', 'Laboral', 'Otro / no aplica'];
---
<form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={SITE.web3formsKey} />
  <input type="hidden" name="subject" value="Nuevo mensaje desde agcriminalistica.com" />
  <input type="hidden" name="from_name" value="Web AG Criminalística" />
  <input type="hidden" name="redirect" value={thanks} />
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="row two">
    <label>
      <span>Nombre completo *</span>
      <input name="nombre" type="text" autocomplete="name" required maxlength="80" />
    </label>
    <label>
      <span>Correo electrónico *</span>
      <input name="email" type="email" autocomplete="email" inputmode="email" required maxlength="120" />
    </label>
  </div>
  <div class="row two">
    <label>
      <span>Teléfono / WhatsApp</span>
      <input name="telefono" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" />
    </label>
    <label>
      <span>Me interesa *</span>
      <select name="interes" required>
        <option value="" disabled selected>Selecciona una opción</option>
        <optgroup label="Servicios periciales">
          {topics.slice(0, 3).map((t) => <option value={t.label} data-key={t.key}>{t.label}</option>)}
        </optgroup>
        <optgroup label="Capacitación y recursos">
          {topics.slice(3).map((t) => <option value={t.label} data-key={t.key}>{t.label}</option>)}
        </optgroup>
      </select>
    </label>
  </div>
  <fieldset class="case">
    <legend>Tipo de caso <small>(opcional)</small></legend>
    <div class="chips">
      {caseTypes.map((c) => (
        <label class="chip"><input type="radio" name="tipo_caso" value={c} /><span>{c}</span></label>
      ))}
    </div>
  </fieldset>
  <label>
    <span>Mensaje *</span>
    <textarea name="mensaje" rows="5" required maxlength="2000" placeholder="Cuéntanos brevemente tu caso o consulta"></textarea>
  </label>
  <label class="consent">
    <input type="checkbox" name="acepta_privacidad" value="Sí" required />
    <span>Acepto la <a href="/privacidad/">política de privacidad</a> y que me contacten para responder mi consulta.</span>
  </label>

  <!-- hCaptcha, validated by Web3Forms; its script is loaded on first interaction. -->
  <div class="h-captcha" data-captcha="true"></div>

  <button class="btn btn-primary submit" type="submit">
    <Icon name="arrow" /> Enviar mensaje
  </button>
  <p class="status" role="status" aria-live="polite"></p>
</form>

<script>
  const W3F_SCRIPT = 'https://web3forms.com/client/script.js';
  const MIN_FILL_MS = 3000;
  let captchaRequested = false;

  // Load Web3Forms' hCaptcha helper only once someone starts using a form, so
  // pages stay fast. If the helper waits for page-load events that already
  // fired, replay them once so it can render the widget.
  function loadCaptcha() {
    if (captchaRequested) return;
    captchaRequested = true;
    const s = document.createElement('script');
    s.src = W3F_SCRIPT;
    s.async = true;
    s.onload = () => {
      setTimeout(() => {
        if (!document.querySelector('.h-captcha iframe')) document.dispatchEvent(new Event('DOMContentLoaded'));
      }, 300);
    };
    document.head.appendChild(s);
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('.contact-form')) {
    const select = form.querySelector<HTMLSelectElement>('select[name="interes"]')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const shownAt = performance.now();
    let sending = false;

    const preset = new URLSearchParams(location.search).get('interes');
    const match = preset && select.querySelector<HTMLOptionElement>(`option[data-key="${CSS.escape(preset)}"]`);
    if (match) select.value = match.value;

    form.addEventListener('focusin', loadCaptcha, { once: true });
    form.addEventListener('pointerdown', loadCaptcha, { once: true });

    const say = (kind: '' | 'ok' | 'err', text: string) => {
      status.className = `status ${kind}`.trim();
      status.textContent = text;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;

      const data = new FormData(form);
      // Honeypot ticked or form filled impossibly fast: pretend success, send nothing.
      if (data.get('botcheck') || performance.now() - shownAt < MIN_FILL_MS) {
        form.reset();
        say('ok', '¡Gracias! Recibimos tu mensaje y te responderemos muy pronto.');
        return;
      }
      for (const [k, v] of [...data.entries()]) if (typeof v === 'string') data.set(k, v.trim());

      const captcha = form.querySelector<HTMLTextAreaElement>('[name="h-captcha-response"]');
      if (captcha && !captcha.value) {
        say('err', 'Por favor completa la verificación "No soy un robot" antes de enviar.');
        return;
      }

      sending = true;
      button.disabled = true;
      say('', 'Enviando…');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.message);
        form.reset();
        (window as unknown as { hcaptcha?: { reset(): void } }).hcaptcha?.reset();
        say('ok', '¡Gracias! Recibimos tu mensaje y te responderemos muy pronto.');
      } catch {
        say('err', 'No pudimos enviar el mensaje. Inténtalo de nuevo o escríbenos por WhatsApp.');
      } finally {
        sending = false;
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-form { display: grid; gap: 1rem; }
  .row { display: grid; gap: 1rem; }
  @media (min-width: 640px) { .row.two { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: 0.4rem; }
  label > span { font-weight: 600; font-size: 0.92rem; }
  input:not([type='checkbox']), select, textarea {
    width: 100%; min-height: 52px; padding: 0.8rem 1rem;
    font-size: 16px; /* prevents iOS zoom on focus */
    background: var(--white); color: var(--text);
    border: 1.5px solid var(--line); border-radius: 10px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  textarea { resize: vertical; min-height: 140px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 4px rgba(27, 163, 224, 0.2); }
  .consent { display: flex; gap: 0.7rem; align-items: flex-start; font-size: 0.9rem; }
  .consent span { font-weight: 400; }
  .consent input { width: 22px; height: 22px; margin-top: 2px; accent-color: var(--cyan-ink); flex: none; }
  .submit { justify-self: start; }
  @media (max-width: 479px) { .submit { justify-self: stretch; } }
  .submit:disabled { opacity: 0.6; cursor: wait; }
  .case { border: 0; padding: 0; min-width: 0; }
  legend { font-weight: 600; font-size: 0.92rem; margin-bottom: 0.4rem; }
  legend small { font-weight: 400; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { position: relative; display: inline-flex; cursor: pointer; }
  .chip input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; pointer-events: none; }
  .chip span { display: inline-flex; align-items: center; min-height: 42px; padding: 0.4rem 0.95rem; border: 1.5px solid var(--line); border-radius: 999px; background: var(--white); font-size: 0.9rem; font-weight: 600; }
  .chip input:checked + span { background: var(--ink); color: var(--white); border-color: var(--ink); }
  .chip input:focus-visible + span { outline: 3px solid var(--amber); outline-offset: 2px; }
  .h-captcha:empty { display: none; }
  .hp { position: absolute; left: -9999px; opacity: 0; }
  .status:empty { display: none; }
  .status { font-weight: 600; padding: 0.8rem 1rem; border-radius: 10px; background: rgba(27, 163, 224, 0.1); }
  .status.ok { background: rgba(37, 211, 102, 0.15); color: #0b5a2a; }
  .status.err { background: rgba(220, 53, 69, 0.12); color: #8a1622; }
</style>

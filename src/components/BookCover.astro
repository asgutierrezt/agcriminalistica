---
/**
 * Typographic cover in the AG style (we can't host Amazon's real covers).
 * Colour is picked per topic so the shelf looks varied but on-brand.
 */
import type { LibraryItem } from '../data/library';
interface Props { item: LibraryItem; size?: 'sm' | 'md' | 'lg' }
const { item, size = 'md' } = Astro.props;
const PALETTES: Record<string, [string, string, string]> = {
  'Criminalística general': ['#171a1f', '#d4b979', '#c9a45c'],
  Criminología: ['#3a1f2b', '#e07a5f', '#f2cc8f'],
  Dactiloscopia: ['#14263a', '#c9a45c', '#ffffff'],
  'Prueba pericial': ['#1c2a1f', '#7fb069', '#e6f2d8'],
  'Ciencias forenses': ['#10283d', '#2c9cdb', '#e9f1f7'],
  'Escena del crimen': ['#2a1a12', '#c9a45c', '#ffe9b0'],
  'Investigación de homicidios': ['#2b0f12', '#ff5a4d', '#ffd6d1'],
  'Fotografía forense': ['#1d1d29', '#9b8cff', '#ece9ff'],
  'Manchas hemáticas': ['#3b0d10', '#ff6b5e', '#ffe1dc'],
  Balística: ['#1f2328', '#c29a3c', '#f4e6c4'],
  'Informática forense': ['#081a2b', '#3ddc97', '#d6fff0'],
};
const [bg, accent, ink] = PALETTES[item.topic] ?? ['#132a40', '#d4b979', '#e9f1f7'];
const isBook = item.cat !== 'equipo';
const short = item.title.split(':')[0];
// Title size follows the cover width (cqi) and shrinks for long words so none gets clipped.
const longest = Math.max(...short.split(/\s+/).map((w) => w.length));
const ttlSize = Math.min(15, 158 / longest).toFixed(1);
---
<div class:list={['cover', size, { gear: !isBook }]} style={`--bg:${bg};--ac:${accent};--ink:${ink};--ttl:${ttlSize}cqi`} aria-hidden="true">
  {isBook ? (
    <>
      <span class="band">{item.topic}</span>
      <span class="rule"></span>
      <span class="ttl">{short}</span>
      {item.author && <span class="aut">{item.author.split(' y ')[0]}</span>}
      <span class="mark">AG · Selección</span>
    </>
  ) : (
    <>
      <svg viewBox="0 0 48 48" class="ico"><circle cx="20" cy="20" r="12" fill="none" stroke="currentColor" stroke-width="3" /><path d="m29 29 11 11" stroke="currentColor" stroke-width="4" stroke-linecap="round" /></svg>
      <span class="ttl">{short}</span>
      <span class="mark">Equipo</span>
    </>
  )}
</div>

<style>
  .cover {
    position: relative; display: flex; flex-direction: column; aspect-ratio: 2 / 3; padding: 9% 9% 8%; overflow: hidden; container-type: inline-size;
    border-radius: 3px 10px 10px 3px; background: var(--bg); color: var(--ink);
    box-shadow: inset 7px 0 0 rgba(255, 255, 255, 0.07), inset 9px 0 0 rgba(0, 0, 0, 0.25), 0 14px 26px -14px rgba(14, 16, 19, 0.8);
    transform: perspective(600px) rotateY(-8deg); transform-origin: left center; transition: transform 0.25s ease;
  }
  :global(a:hover) .cover, :global(article:hover) .cover { transform: perspective(600px) rotateY(0deg); }
  .cover::after { content: ''; position: absolute; right: -30%; bottom: -20%; width: 90%; aspect-ratio: 1; border-radius: 50%; border: 10px solid var(--ac); opacity: 0.12; }
  .band { font-family: var(--font-mono); font-size: 0.5em; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ac); line-height: 1.2; }
  /* Accent rule sits in the flow between topic and title, so it never crosses the text. */
  .rule { flex: none; height: 4px; margin: 18% -9% 0.55em; background: var(--ac); }
  .ttl { font-weight: 900; line-height: 1.02; letter-spacing: -0.02em; font-size: var(--ttl, 1em); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .aut { margin-top: auto; font-size: 0.52em; opacity: 0.85; font-weight: 600; }
  .mark { margin-top: 0.35em; font-family: var(--font-mono); font-size: 0.42em; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ac); }
  .sm { font-size: 0.5rem; padding: 9% 7% 8% 11%; }
  .sm .band, .sm .aut { display: none; }
  .sm .rule { height: 3px; margin: 40% -7% 0.5em -11%; }
  .md { font-size: 0.95rem; }
  .lg { font-size: 1.25rem; }
  .gear { aspect-ratio: 1; border-radius: 14px; transform: none; justify-content: space-between; }
  .gear .ttl { margin-top: 0; font-size: calc(var(--ttl) * 0.8); }
  .ico { width: 40%; color: var(--ac); }
  @media (prefers-reduced-motion: reduce) { .cover { transform: none; } }
</style>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate, readingTime, type Post } from '../lib/utils';
interface Props { post: Post; index?: number; eager?: boolean; headingLevel?: 2 | 3 }
const { post, index, eager = false, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const { title, cover, coverAlt, category, pubDate } = post.data;
---
<article class="post-card reveal">
  <a href={`/${post.id}/`} class="media" tabindex="-1" aria-hidden="true">
    <Image
      src={cover}
      alt=""
      widths={[360, 560, 760]}
      sizes="(min-width: 1040px) 360px, (min-width: 720px) 45vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager && index === 0 ? 'high' : 'auto'}
      class="img"
    />
    {index !== undefined && <span class="exp">EXP-{String(index + 1).padStart(3, '0')}</span>}
  </a>
  <div class="body">
    <p class="meta"><span class="cat">{category}</span> · <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></p>
    <H class="title"><a href={`/${post.id}/`}>{title}</a></H>
    <p class="excerpt">{post.data.description}</p>
    <p class="foot"><Icon name="clock" size={16} /> {readingTime(post.body)} min de lectura</p>
  </div>
</article>

<style>
  .post-card {
    display: grid; grid-template-rows: auto 1fr;
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .post-card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -22px rgba(8, 19, 31, 0.35); }
  .media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--paper-2); }
  .img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .post-card:hover .img { transform: scale(1.04); }
  .exp {
    position: absolute; left: 12px; top: 12px; background: var(--amber); color: var(--ink);
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; padding: 0.3rem 0.5rem; border-radius: 4px;
  }
  .body { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.25rem 1.25rem 1.4rem; }
  .meta { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .cat { color: var(--cyan-ink); font-weight: 700; }
  .title { font-size: 1.22rem; line-height: 1.2; }
  .title a { text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .post-card { position: relative; }
  .title a:hover { color: var(--cyan-ink); }
  .excerpt { color: var(--muted); font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { margin-top: auto; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; color: var(--muted); }
</style>

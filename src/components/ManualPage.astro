---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';
import { breadcrumbSchema } from '../lib/schema';
import { SITE, whatsappLink } from '../data/site';

interface Props {
  slug: string;
  interes: string;
  title: string;
  seoTitle: string;
  description: string;
  lead: string;
  cover: ImageMetadata;
  coverAlt: string;
  topics: string[];
  related: { href: string; label: string };
}
const p = Astro.props;
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Recursos', path: '/cursos/' },
  { name: p.title, path: `/${p.slug}/` },
];
const book = {
  '@type': 'Book',
  name: p.title,
  description: p.description,
  inLanguage: SITE.lang,
  bookFormat: 'https://schema.org/EBook',
  isAccessibleForFree: true,
  publisher: { '@id': `${SITE.url}/#organization` },
  image: new URL(p.cover.src, SITE.url).href,
};
---
<Base title={p.seoTitle} description={p.description} image={p.cover} imageAlt={p.coverAlt} schema={[book, breadcrumbSchema(crumbs)]}>
  <PageHero label="Manual gratuito · PDF" title={p.title} lead={p.lead} crumbs={crumbs} />
  <section class="section">
    <div class="container layout">
      <Image src={p.cover} alt={p.coverAlt} widths={[400, 640, 900]} sizes="(min-width: 900px) 520px, 92vw" loading="eager" class="cover" />
      <div>
        <h2>¿Qué encontrarás?</h2>
        <ul class="checks">{p.topics.map((t) => <li><Icon name="check" size={20} /> <span>{t}</span></li>)}</ul>
        <div class="box">
          <p><strong>Solicítalo gratis.</strong> Escríbenos y te lo enviamos directamente a tu correo o WhatsApp.</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={`/contacto/?interes=${p.interes}`}><Icon name="download" /> Solicitar manual</a>
            <a class="btn btn-ghost" href={whatsappLink(`Hola, quisiera recibir el ${p.title}.`)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
          </div>
        </div>
        <p class="rel">Lee también: <a href={p.related.href}>{p.related.label}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .layout { grid-template-columns: 0.9fr 1.1fr; } }
  .cover { width: 100%; border-radius: 18px; box-shadow: 0 30px 60px -30px rgba(8, 19, 31, 0.45); }
  h2 { font-size: var(--step-2); margin-bottom: 1rem; }
  .checks { list-style: none; padding: 0; display: grid; gap: 0.8rem; }
  .checks li { display: flex; gap: 0.7rem; align-items: flex-start; }
  .checks :global(svg) { color: var(--cyan-ink); flex: none; margin-top: 3px; }
  .box { margin-top: 2rem; padding: 1.5rem; border-radius: 16px; background: var(--white); border: 1px solid var(--line); border-left: 5px solid var(--amber); display: grid; gap: 1rem; }
  .rel { margin-top: 1.5rem; color: var(--muted); }
  .rel a { color: var(--cyan-ink); font-weight: 600; }
</style>

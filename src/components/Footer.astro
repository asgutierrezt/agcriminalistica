---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, whatsappLink } from '../data/site';
import { AFFILIATE_DISCLOSURE } from '../data/affiliate';
const year = new Date().getFullYear();
---
<footer class="site-footer ink grid-bg">
  <div class="tape" aria-hidden="true">
    <span>{'ESCENA DEL CRIMEN · NO CRUZAR · AG CRIMINALÍSTICA · '.repeat(8)}</span>
  </div>
  <div class="container cols">
    <div class="about">
      <Logo size={44} />
      <p>
        Peritaje criminalístico, reconstrucción 3D de los hechos y consultoría pericial para abogados en todo
        Ecuador. Formamos peritos con cursos online de criminalística. Trabajamos en colaboración con la consultora
        pericial <strong>{SITE.partner}</strong>
      </p>
      <ul class="social" aria-label="Redes sociales">
        <li><a href={SITE.social.facebook} rel="noopener" target="_blank" aria-label="Facebook"><Icon name="facebook" /></a></li>
        <li><a href={SITE.social.instagram} rel="noopener" target="_blank" aria-label="Instagram"><Icon name="instagram" /></a></li>
        <li><a href={SITE.social.linkedin} rel="noopener" target="_blank" aria-label="LinkedIn"><Icon name="linkedin" /></a></li>
      </ul>
    </div>
    <nav aria-label="Servicios">
      <h2>Servicios</h2>
      <ul>
        <li><a href="/servicios/reconstruccion-3d-de-hechos/">Reconstrucción 3D de los hechos</a></li>
        <li><a href="/servicios/peritaje-criminalistico/">Peritaje criminalístico</a></li>
        <li><a href="/servicios/consultoria-para-abogados/">Consultoría para abogados</a></li>
        <li><a href="/servicios/">Todos los servicios</a></li>
      </ul>
    </nav>
    <nav aria-label="Capacitación">
      <h2>Capacitación</h2>
      <ul>
        <li><a href="/courses/criminalistica/">Formación de peritos</a></li>
        <li><a href="/courses/informatica-forense/">Informática forense</a></li>
        <li><a href="/courses/investigacion-del-crimen/">Investigación del crimen</a></li>
        <li><a href="/manual-dactiloscopia/">Manual de dactiloscopia</a></li>
        <li><a href="/manual-identificacion-forense-de-la-voz/">Manual de identificación de voz</a></li>
      </ul>
    </nav>
    <nav aria-label="Sitio">
      <h2>Explorar</h2>
      <ul>
        <li><a href="/nosotros/">Nosotros</a></li>
        <li><a href="/blog/">Blog forense</a></li>
        <li><a href="/glosario/">Glosario forense</a></li>
        <li><a href="/biblioteca/">Biblioteca forense</a></li>
        <li><a href="/#preguntas">Preguntas frecuentes</a></li>
        <li><a href="/privacidad/">Política de privacidad</a></li>
      </ul>
      <h2 class="mt">Contacto</h2>
      <ul class="contact">
        <li><a href="/contacto/"><Icon name="chat" size={20} /> Formulario de contacto</a></li>
        <li><a href={whatsappLink()} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} /> WhatsApp</a></li>
        <li><span><Icon name="pin" size={20} /> Todo Ecuador</span></li>
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>© {year} {SITE.legalName}. Todos los derechos reservados.</p>
    <p><a href="/privacidad/">Privacidad</a></p>
    <p class="aff">{AFFILIATE_DISCLOSURE}</p>
  </div>
  <!-- Developer credit: opens a ready-to-send email to the developer. The address is
       assembled in the browser, so it never appears in the HTML for scrapers. -->
  <div class="container credit">
    <a class="dev" href="/contacto/" data-dev data-u="maximilianoalonso2012.ma" data-d="gmail.com"
       aria-label="Página creada por Codemaxon. Escribir un correo al programador">
      <span class="code" aria-hidden="true">&lt;/&gt;</span>
      <span class="who">Página creada por <strong class="glitch" data-text="Codemaxon">Codemaxon</strong></span>
      <span class="go" aria-hidden="true">Escríbele al programador <span class="arr">→</span></span>
    </a>
  </div>
</footer>

<script>
  const dev = document.querySelector<HTMLAnchorElement>('[data-dev]');
  if (dev) {
    const subject = 'Vengo de agcriminalistica.com: quiero una web así';
    const body = [
      'Hola, Codemaxon:',
      '',
      'Acabo de recorrer la web de AG Criminalística (la bala en 3D, la escena del crimen, el luminol...) y quiero algo con ese nivel para mi proyecto.',
      '',
      '— Mi proyecto / negocio: ',
      '— Qué necesito (web, tienda online, landing, efectos 3D...): ',
      '— Para cuándo lo necesito: ',
      '— Presupuesto aproximado: ',
      '',
      'Mis datos para que me contactes:',
      'Nombre: ',
      'WhatsApp: ',
      '',
      '¡Quedo atento!',
      '',
      '— Enviado desde la firma al pie de agcriminalistica.com',
    ].join('\n');
    const arm = () => {
      dev.href = `mailto:${dev.dataset.u}@${dev.dataset.d}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };
    // Set before the visitor activates it (hover, focus or first touch).
    ['pointerenter', 'focus', 'touchstart'].forEach((ev) => dev.addEventListener(ev, arm, { once: true, passive: true }));
    dev.addEventListener('click', arm);
  }
</script>

<style>
  .site-footer { padding-bottom: 6rem; overflow: hidden; }
  .tape {
    background: var(--amber); color: var(--ink);
    font-family: var(--font-mono); font-weight: 800; font-size: 0.68rem; letter-spacing: 0.2em;
    white-space: nowrap; overflow: hidden; padding: 0.32rem 0;
    transform: rotate(-1.2deg) scale(1.03); margin: 0 -2rem 3.5rem;
  }
  .tape span { display: block; }
  /* The tape slides as the footer scrolls into view (CSS only, where supported). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tape span { animation: tape-slide linear both; animation-timeline: view(); }
    }
  }
  @keyframes tape-slide { from { transform: translateX(0); } to { transform: translateX(-22%); } }
  .cols { display: grid; gap: 2.5rem; }
  @media (min-width: 720px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .cols { grid-template-columns: 1.4fr 1fr 1fr 0.9fr; } }
  .mt { margin-top: 1.6rem; }
  .about p { margin-top: 1.1rem; font-size: 0.95rem; max-width: 44ch; }
  .about strong { color: var(--white); }
  h2 { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber); margin-bottom: 1rem; font-weight: 700; }
  ul { list-style: none; padding: 0; display: grid; gap: 0.15rem; }
  nav a, .contact a, .contact span {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 40px;
    color: var(--muted-on-ink); text-decoration: none; font-size: 0.95rem; word-break: break-word;
  }
  nav a:hover, .contact a:hover { color: var(--white); }
  .social { display: flex; gap: 0.5rem; margin-top: 1.25rem; }
  .social a {
    display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%;
    border: 1px solid var(--line-on-ink); color: var(--white);
  }
  .social a:hover { background: var(--cyan); color: var(--ink); border-color: var(--cyan); }
  .aff { flex-basis: 100%; font-size: 0.8rem; opacity: 0.8; }
  /* Developer credit: stands out a little, with a gradient border and glow. */
  .credit { display: flex; justify-content: center; margin-top: 1.6rem; }
  /* Phones: leave the right edge to the floating "back to top" / WhatsApp buttons. */
  @media (max-width: 640px) { .credit { justify-content: flex-start; padding-right: 64px; } .dev { justify-content: flex-start; border-radius: 20px; } }
  .dev {
    display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.5rem 0.75rem;
    padding: 0.55rem 0.7rem 0.55rem 0.55rem; border-radius: 999px; text-decoration: none; color: var(--muted-on-ink);
    border: 1px solid transparent;
    background:
      linear-gradient(var(--ink-2), var(--ink-2)) padding-box,
      linear-gradient(100deg, var(--cyan), rgba(255, 255, 255, 0.15) 45%, var(--amber)) border-box;
    box-shadow: 0 10px 30px -18px rgba(27, 163, 224, 0.7);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .dev:hover, .dev:focus-visible { transform: translateY(-2px); box-shadow: 0 14px 34px -14px rgba(27, 163, 224, 0.9), 0 0 0 4px rgba(27, 163, 224, 0.12); }
  .code {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    font-family: var(--font-mono); font-size: 0.72rem; font-weight: 800; color: var(--ink);
    background: linear-gradient(135deg, var(--cyan), var(--amber));
  }
  .who { font-size: 0.88rem; }
  .who strong { color: var(--white); font-weight: 800; letter-spacing: 0.02em; display: inline-block; }
  .go {
    display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.7rem; border-radius: 999px;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--amber); background: rgba(245, 183, 10, 0.1); border: 1px solid rgba(245, 183, 10, 0.35);
  }
  .arr { transition: transform 0.25s ease; }
  .dev:hover .arr { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) { .dev, .arr { transition: none; } }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;
    margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line-on-ink); font-size: 0.85rem;
  }
</style>

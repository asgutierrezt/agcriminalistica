---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, whatsappLink } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer ink grid-bg">
  <div class="tape" aria-hidden="true">
    <span>{'ESCENA DEL CRIMEN · NO CRUZAR · AG CRIMINALÍSTICA · '.repeat(8)}</span>
  </div>
  <div class="container cols">
    <div class="about">
      <Logo size={44} />
      <p>
        Peritaje criminalístico, reconstrucción 3D de los hechos y consultoría pericial para abogados en todo
        Ecuador. Formamos peritos con cursos online de criminalística. Trabajamos en colaboración con la consultora
        pericial <strong>{SITE.partner}</strong>
      </p>
      <ul class="social" aria-label="Redes sociales">
        <li><a href={SITE.social.facebook} rel="noopener" target="_blank" aria-label="Facebook"><Icon name="facebook" /></a></li>
        <li><a href={SITE.social.instagram} rel="noopener" target="_blank" aria-label="Instagram"><Icon name="instagram" /></a></li>
        <li><a href={SITE.social.linkedin} rel="noopener" target="_blank" aria-label="LinkedIn"><Icon name="linkedin" /></a></li>
      </ul>
    </div>
    <nav aria-label="Servicios">
      <h2>Servicios</h2>
      <ul>
        <li><a href="/servicios/reconstruccion-3d-de-hechos/">Reconstrucción 3D de los hechos</a></li>
        <li><a href="/servicios/peritaje-criminalistico/">Peritaje criminalístico</a></li>
        <li><a href="/servicios/consultoria-para-abogados/">Consultoría para abogados</a></li>
        <li><a href="/servicios/">Todos los servicios</a></li>
      </ul>
    </nav>
    <nav aria-label="Capacitación">
      <h2>Capacitación</h2>
      <ul>
        <li><a href="/courses/criminalistica/">Formación de peritos</a></li>
        <li><a href="/courses/informatica-forense/">Informática forense</a></li>
        <li><a href="/courses/investigacion-del-crimen/">Investigación del crimen</a></li>
        <li><a href="/manual-dactiloscopia/">Manual de dactiloscopia</a></li>
        <li><a href="/manual-identificacion-forense-de-la-voz/">Manual de identificación de voz</a></li>
      </ul>
    </nav>
    <nav aria-label="Sitio">
      <h2>Explorar</h2>
      <ul>
        <li><a href="/nosotros/">Nosotros</a></li>
        <li><a href="/blog/">Blog forense</a></li>
        <li><a href="/glosario/">Glosario forense</a></li>
        <li><a href="/biblioteca/">Biblioteca forense</a></li>
        <li><a href="/#preguntas">Preguntas frecuentes</a></li>
        <li><a href="/privacidad/">Política de privacidad</a></li>
      </ul>
      <h2 class="mt">Contacto</h2>
      <ul class="contact">
        <li><a href="/contacto/"><Icon name="chat" size={20} /> Formulario de contacto</a></li>
        <li><a href={whatsappLink()} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} /> WhatsApp</a></li>
        <li><span><Icon name="pin" size={20} /> Todo Ecuador</span></li>
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>© {year} {SITE.legalName}. Todos los derechos reservados.</p>
    <p><a href="/privacidad/">Privacidad</a></p>
    <p class="aff">Como afiliado de Amazon, AG Criminalística gana con las compras que cumplen los requisitos.</p>
  </div>
</footer>

<style>
  .site-footer { padding-bottom: 6rem; overflow: hidden; }
  .tape {
    background: var(--amber); color: var(--ink);
    font-family: var(--font-mono); font-weight: 800; font-size: 0.68rem; letter-spacing: 0.2em;
    white-space: nowrap; overflow: hidden; padding: 0.32rem 0;
    transform: rotate(-1.2deg) scale(1.03); margin: 0 -2rem 3.5rem;
  }
  .cols { display: grid; gap: 2.5rem; }
  @media (min-width: 720px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .cols { grid-template-columns: 1.4fr 1fr 1fr 0.9fr; } }
  .mt { margin-top: 1.6rem; }
  .about p { margin-top: 1.1rem; font-size: 0.95rem; max-width: 44ch; }
  .about strong { color: var(--white); }
  h2 { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber); margin-bottom: 1rem; font-weight: 700; }
  ul { list-style: none; padding: 0; display: grid; gap: 0.15rem; }
  nav a, .contact a, .contact span {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 40px;
    color: var(--muted-on-ink); text-decoration: none; font-size: 0.95rem; word-break: break-word;
  }
  nav a:hover, .contact a:hover { color: var(--white); }
  .social { display: flex; gap: 0.5rem; margin-top: 1.25rem; }
  .social a {
    display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%;
    border: 1px solid var(--line-on-ink); color: var(--white);
  }
  .social a:hover { background: var(--cyan); color: var(--ink); border-color: var(--cyan); }
  .aff { flex-basis: 100%; font-size: 0.8rem; opacity: 0.8; }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;
    margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line-on-ink); font-size: 0.85rem;
  }
</style>

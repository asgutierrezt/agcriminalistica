---
/**
 * Interactive 3D crime scene (Three.js). The library is only downloaded after
 * the visitor's first interaction and once the scene is near the viewport, so
 * it never competes with the page's content.
 * Until then — or without WebGL/JS — a poster rendered from the scene's own
 * first frame is shown, so the switch to live 3D is seamless. The evidence
 * list and cards work either way.
 */
import { getImage } from 'astro:assets';
import { SCENE_EVIDENCE, SCENE_VIEWS } from '../data/sceneEvidence';
// Posters: regenerate when the scene changes (first frame, orbital view).
import posterCompact from '../assets/img/escena-3d-inicio.jpg';
import posterWide from '../assets/img/escena-3d-servicio-lg.jpg';
import posterTall from '../assets/img/escena-3d-servicio-sm.jpg';

interface Props { caption?: string; class?: string; variant?: 'compact' | 'full'; priority?: boolean }
const { caption, class: cls, variant = 'compact', priority = false } = Astro.props;
const full = variant === 'full';

type Src = typeof posterCompact;
const sources = async (src: Src, widths: number[]) => ({
  avif: (await getImage({ src, widths, format: 'avif' })).srcSet.attribute,
  webp: await getImage({ src, widths, format: 'webp' }),
});
const main = full
  ? await sources(posterWide, [800, 1200, 1600, 2100])
  : await sources(posterCompact, [480, 720, 1000]);
const tall = full ? await sources(posterTall, [400, 600, 762]) : null;
const mainSizes = full ? '(max-width: 1240px) calc(100vw - 40px), 1200px' : '(max-width: 1000px) calc(100vw - 40px), 572px';
const posterAlt = full
  ? 'Reconstrucción 3D de una escena del crimen: sala con la víctima, el arma y los indicios'
  : 'Reconstrucción 3D de una escena del crimen: origen del disparo, trayectorias, víctima e indicios numerados';
---
<figure class:list={['scene3d', cls, variant]} data-scene-root>
  <div class="stage" data-scene3d>
    <picture class="poster">
      {tall && <source media="(max-width: 640px)" type="image/avif" srcset={tall.avif} sizes="calc(100vw - 32px)" />}
      {tall && <source media="(max-width: 640px)" type="image/webp" srcset={tall.webp.srcSet.attribute} sizes="calc(100vw - 32px)" />}
      <source type="image/avif" srcset={main.avif} sizes={mainSizes} />
      <img
        src={main.webp.src}
        srcset={main.webp.srcSet.attribute}
        sizes={mainSizes}
        alt={posterAlt}
        width={(full ? posterWide : posterCompact).width}
        height={(full ? posterWide : posterCompact).height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </picture>

    <div class="views" role="toolbar" aria-label="Vista de la cámara">
      {SCENE_VIEWS.map((v, i) => (
        <button type="button" data-view={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>
      ))}
    </div>

    <button type="button" class="lumi" data-luminol aria-pressed="false" aria-describedby="lumi-d">
      <span class="lumi-dot" aria-hidden="true"></span><span data-lumi-label>Luminol</span>
    </button>
    <span id="lumi-d" hidden>Apaga la luz y revela rastros de sangre ocultos</span>
    <div class="flash" aria-hidden="true"></div>

    <p class="hint" aria-hidden="true">Toca un marcador ▲</p>

    {full && (
      <div class="timeline">
        <button type="button" class="play" data-play aria-label="Reproducir reconstrucción">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path class="i-play" d="M7 5v14l12-7Z" fill="currentColor" /><path class="i-pause" d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" /></svg>
        </button>
        <input type="range" min="0" max="1000" value="0" step="1" data-scrub aria-label="Línea de tiempo de la reconstrucción" />
        <span class="tc" data-tc>00:00</span>
      </div>
    )}
  </div>

  <div class="cards">
      {SCENE_EVIDENCE.map((ev, i) => (
        <article class="card" data-card={i} hidden aria-live="polite">
          <header>
            <span class="mk">{ev.n}</span>
            <h3>{ev.title}</h3>
            <button type="button" class="x" data-close aria-label="Cerrar ficha">×</button>
          </header>
          <p>{ev.text}</p>
          <footer>
            <a href={ev.link.href}>{ev.link.label} →</a>
            <span class="nav">
              <button type="button" data-step="-1" aria-label="Indicio anterior">‹</button>
              <button type="button" data-step="1" aria-label="Indicio siguiente">›</button>
            </span>
          </footer>
        </article>
      ))}

  </div>

  <ol class="evidence" aria-label="Indicios de la escena">
    {SCENE_EVIDENCE.map((ev, i) => (
      <li><button type="button" data-ev={i}><span class="mk">{ev.n}</span>{ev.title}</button></li>
    ))}
  </ol>
  {caption && <figcaption><span class="dot"></span>{caption}</figcaption>}
</figure>

<script>
  import { loadModule, reloadedForUpdate } from '../lib/loadModule';
  import type { CrimeSceneController } from '../lib/crimeScene';

  const fmt = (s: number) => `00:${String(Math.floor(s)).padStart(2, '0')}`;

  function wire(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-scene3d]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const evButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-ev]')];
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]');
    const scrub = root.querySelector<HTMLInputElement>('[data-scrub]');
    const tc = root.querySelector<HTMLElement>('[data-tc]');
    const lumiBtn = root.querySelector<HTMLButtonElement>('[data-luminol]');
    const lumiLabel = root.querySelector<HTMLElement>('[data-lumi-label]');
    const flash = root.querySelector<HTMLElement>('.flash');
    let ctrl: CrimeSceneController | null = null;
    let current: number | null = null;

    const show = (i: number | null) => {
      // Forensic photo flash when an item of evidence is documented.
      if (i !== null && i !== current && root.classList.contains('is-live') && flash) {
        flash.classList.remove('go');
        void flash.offsetWidth;
        flash.classList.add('go');
      }
      current = i;
      cards.forEach((c, k) => (c.hidden = k !== i));
      evButtons.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
      ctrl?.select(i);
      root.classList.toggle('has-card', i !== null);
    };
    evButtons.forEach((b, i) => b.addEventListener('click', () => show(current === i ? null : i)));
    root.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => show(null)));
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        const n = cards.length;
        show((((current ?? 0) + Number(b.dataset.step)) % n + n) % n);
      }),
    );
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && current !== null) show(null);
    });

    const setPlaying = (p: boolean) => {
      root.classList.toggle('is-playing', p);
      playBtn?.setAttribute('aria-label', p ? 'Pausar reconstrucción' : 'Reproducir reconstrucción');
    };

    const mount = async () => {
      const lib = await loadModule(() => import('../lib/crimeScene'));
      if (!lib) return;
      const { mountCrimeScene } = lib;
      ctrl = mountCrimeScene(stage, {
        intro: !!playBtn,
        onSelect: (i) => show(i),
        onTime: (t, playing) => {
          if (scrub && ctrl) scrub.value = String(Math.round((t / ctrl.duration) * 1000));
          if (tc) tc.textContent = fmt(t);
          setPlaying(playing);
        },
      });
      if (!ctrl) return;
      root.classList.add('is-live');
      setPlaying(ctrl.playing);
      if (current !== null) ctrl.select(current);
      if (root.classList.contains('is-luminol')) ctrl.setLuminol(true);
    };

    viewButtons.forEach((b) =>
      b.addEventListener('click', () => {
        viewButtons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        ctrl?.setView(b.dataset.view as Parameters<CrimeSceneController['setView']>[0]);
      }),
    );
    lumiBtn?.addEventListener('click', () => {
      const on = lumiBtn.getAttribute('aria-pressed') !== 'true';
      lumiBtn.setAttribute('aria-pressed', String(on));
      root.classList.toggle('is-luminol', on);
      if (lumiLabel) lumiLabel.textContent = on ? 'Luminol · rastros ocultos' : 'Luminol';
      ctrl?.setLuminol(on);
    });
    playBtn?.addEventListener('click', () => {
      if (!ctrl) return;
      if (ctrl.playing) ctrl.pause();
      else {
        show(null);
        ctrl.play();
      }
      setPlaying(ctrl.playing);
    });
    scrub?.addEventListener('input', () => {
      if (!ctrl) return;
      const t = (Number(scrub.value) / 1000) * ctrl.duration;
      ctrl.setTime(t);
      if (tc) tc.textContent = fmt(t);
      setPlaying(false);
    });

    return mount;
  }

  const mounts = [...document.querySelectorAll<HTMLElement>('[data-scene-root]')].map((root) => ({
    root,
    mount: wire(root),
  }));

  // Start the 3D scene only on the visitor's first interaction (touch, mouse,
  // wheel, keyboard or scroll, including dragging the scrollbar). Until then the
  // poster, rendered from the scene's own first frame, looks identical, and
  // three.js costs nothing: no timers.
  let started = false;
  const EVENTS = ['pointerdown', 'touchstart', 'wheel', 'keydown', 'mousemove', 'scroll'];
  const start = () => {
    if (started) return;
    started = true;
    EVENTS.forEach((ev) => removeEventListener(ev, start));
    for (const { root, mount } of mounts) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          void mount();
        },
        { rootMargin: '200px' },
      );
      io.observe(root);
    }
  };
  EVENTS.forEach((ev) => addEventListener(ev, start, { once: true, passive: true }));
  if (reloadedForUpdate()) start();
</script>

<style>
  .scene3d { position: relative; margin: 0; --ink-glass: rgba(8, 19, 31, 0.78); }
  .stage {
    position: relative; width: 100%; aspect-ratio: 4 / 3.3; border-radius: 18px; overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% 40%, rgba(27, 163, 224, 0.16), transparent 60%),
      linear-gradient(180deg, #0c1c2c, #08131f);
    border: 1px solid var(--line-on-ink);
    cursor: grab;
    color: var(--white);
  }
  .full .stage { aspect-ratio: 16 / 10; }
  @media (max-width: 640px) { .full .stage { aspect-ratio: 4 / 4.6; } }
  .stage:active { cursor: grabbing; }
  .poster { position: absolute; inset: 0; transition: opacity 0.6s ease; }
  .poster img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .is-live .poster { opacity: 0; }
  /* WebGL context lost (phone memory, app switch): back to the poster until it returns. */
  .stage.gl-lost .poster { opacity: 1; }
  .stage.gl-lost :global(canvas) { visibility: hidden; }
  .stage :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; display: block; animation: fade 0.8s ease both; }
  @keyframes fade { from { opacity: 0; } }

  /* Overlay controls */
  .views {
    position: absolute; z-index: 2; top: 10px; left: 10px; right: 10px;
    display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none;
    opacity: 0; transform: translateY(-6px); transition: opacity 0.4s ease, transform 0.4s ease; pointer-events: none;
  }
  .views::-webkit-scrollbar { display: none; }
  .is-live .views { opacity: 1; transform: none; pointer-events: auto; }
  .views button, .timeline button, .nav button, .x {
    font: inherit; color: inherit; cursor: pointer; border: 1px solid rgba(255, 255, 255, 0.16);
    background: var(--ink-glass); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .views button {
    flex: none; min-height: 36px; padding: 0.35rem 0.8rem; border-radius: 999px;
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .views button:hover { border-color: var(--cyan); }
  .views button[aria-pressed='true'] { background: var(--cyan); color: var(--ink); border-color: var(--cyan); font-weight: 700; }
  /* Luminol toggle: its own button in the bottom-left corner (reachable on phones too). */
  .lumi {
    position: absolute; z-index: 2; left: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: 40px; padding: 0.35rem 0.85rem; border-radius: 999px; cursor: pointer;
    font: inherit; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #bfeaff; background: var(--ink-glass); border: 1px solid rgba(95, 208, 255, 0.5);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    opacity: 0; pointer-events: none; transition: opacity 0.4s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .is-live .lumi { opacity: 1; pointer-events: auto; }
  .full .lumi { bottom: 64px; }
  .lumi-dot { width: 9px; height: 9px; border-radius: 50%; background: #5fd0ff; box-shadow: 0 0 8px #5fd0ff; }
  .lumi[aria-pressed='true'] { background: #0a3550; border-color: #5fd0ff; box-shadow: 0 0 22px -4px #5fd0ff; }
  .is-luminol .hint { opacity: 0 !important; }
  /* Subtle lens vignette over the render. */
  .stage::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(120% 95% at 50% 45%, transparent 60%, rgba(0, 0, 0, 0.35)); }
  .flash { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: #fff; opacity: 0; }
  .flash.go { animation: flash 0.45s ease-out; }
  @keyframes flash { 0% { opacity: 0.75; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .flash.go { animation: none; } }

  .hint {
    position: absolute; z-index: 1; right: 12px; bottom: 12px; margin: 0;
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--amber); background: var(--ink-glass); padding: 0.3rem 0.6rem; border-radius: 6px;
    opacity: 0; transition: opacity 0.4s ease; pointer-events: none;
  }
  .is-live:not(.has-card) .hint { opacity: 1; animation: nudge 2.4s ease-in-out infinite; }
  .full .hint { bottom: 64px; }
  @keyframes nudge { 50% { transform: translateY(-3px); } }

  /* Desktop: cards float over the stage (same box as the stage). Mobile: below it. */
  .cards { position: absolute; z-index: 3; top: 0; left: 0; right: 0; aspect-ratio: 4 / 3.3; pointer-events: none; }
  .full .cards { aspect-ratio: 16 / 10; }
  .card {
    position: absolute; left: 10px; right: 10px; bottom: 10px; pointer-events: auto;
    max-width: 380px; padding: 0.9rem 1rem 0.8rem; border-radius: 14px;
    background: rgba(8, 19, 31, 0.92); border: 1px solid rgba(245, 183, 10, 0.5);
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.8); cursor: auto;
    animation: card-in 0.22s ease-out;
  }
  .full .card { bottom: 64px; }
  @media (max-width: 640px) {
    .cards, .full .cards { position: static; aspect-ratio: auto; }
    .card, .full .card { position: relative; left: auto; right: auto; bottom: auto; max-width: none; margin-top: 0.6rem; }
  }
  @keyframes card-in { from { opacity: 0; transform: translateY(8px); } }
  .card header { display: flex; align-items: center; gap: 0.6rem; }
  .card h3 { font-size: 1.05rem; color: var(--white); flex: 1; }
  .card p { margin: 0.5rem 0 0.7rem; font-size: 0.9rem; line-height: 1.5; color: #c9d6e2; }
  .card footer { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .card a { color: var(--amber); font-weight: 700; font-size: 0.88rem; text-decoration: none; }
  .card a:hover { text-decoration: underline; }
  .x { width: 32px; height: 32px; border-radius: 50%; font-size: 1.2rem; line-height: 1; }
  .nav { display: flex; gap: 6px; }
  .nav button { width: 36px; height: 36px; border-radius: 10px; font-size: 1.2rem; }
  .mk {
    display: inline-grid; place-items: center; width: 26px; height: 26px; flex: none;
    background: var(--amber); color: var(--ink); font-family: var(--font-mono); font-weight: 800; font-size: 0.8rem;
    clip-path: polygon(50% 0, 100% 100%, 0 100%); padding-top: 8px;
  }

  .timeline {
    position: absolute; z-index: 2; left: 10px; right: 10px; bottom: 10px;
    display: flex; align-items: center; gap: 0.75rem; padding: 0.45rem 0.8rem 0.45rem 0.45rem; border-radius: 999px;
    background: var(--ink-glass); border: 1px solid rgba(255, 255, 255, 0.14); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
  }
  .is-live .timeline { opacity: 1; pointer-events: auto; }
  .play { display: grid; place-items: center; width: 40px; height: 40px; flex: none; border-radius: 50%; background: var(--amber) !important; color: var(--ink) !important; border: 0 !important; }
  .i-pause { display: none; }
  .is-playing .i-play { display: none; }
  .is-playing .i-pause { display: inline; }
  .timeline input { flex: 1; accent-color: var(--amber); min-width: 0; height: 32px; }
  .tc { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted-on-ink); min-width: 3.2em; }

  /* Evidence list (always available, also without WebGL) */
  .evidence { list-style: none; padding: 0; margin: 0.8rem 0 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .evidence button {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 40px; padding: 0.3rem 0.8rem 0.3rem 0.4rem;
    border-radius: 999px; cursor: pointer; font: inherit; font-size: 0.85rem; font-weight: 600;
    color: var(--ev-fg, var(--white)); background: var(--ev-bg, rgba(255, 255, 255, 0.06)); border: 1px solid var(--ev-line, var(--line-on-ink));
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .evidence button:hover { border-color: var(--amber); }
  .evidence button[aria-pressed='true'] { border-color: var(--amber); background: rgba(245, 183, 10, 0.16); }
  .evidence .mk { width: 24px; height: 24px; padding-top: 7px; font-size: 0.72rem; }

  figcaption {
    display: flex; align-items: center; gap: 0.5rem; margin-top: 0.7rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fig-caption, var(--muted-on-ink));
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #e5484d; box-shadow: 0 0 0 4px rgba(229, 72, 77, 0.2); animation: rec 1.6s ease-in-out infinite; }
  @keyframes rec { 50% { opacity: 0.35; } }
</style>

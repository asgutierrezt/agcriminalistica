---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Course } from '../lib/utils';
interface Props { course: Course; headingLevel?: 2 | 3 }
const { course, headingLevel = 3 } = Astro.props;
const { title, tagline, cover, code, status, price, modules } = course.data;
const H = `h${headingLevel}` as 'h2' | 'h3';
const href = `/courses/${course.id}/`;
---
<article class="course reveal">
  <div class="media">
    <Image src={cover} alt="" widths={[400, 640, 820]} sizes="(min-width: 1040px) 380px, (min-width: 720px) 45vw, 92vw" class="img" />
    <span class="code">{code}</span>
    {price === 'Gratis' && <span class="free">Gratis</span>}
  </div>
  <div class="body">
    <p class="status"><span class="dot"></span>{status} · 100% online</p>
    <H class="title"><a href={href}>{title}</a></H>
    <p class="tag">{tagline}</p>
    <p class="mods"><Icon name="book" size={18} /> {modules.length} módulos</p>
    <span class="more">Ver programa <Icon name="arrow" size={18} /></span>
  </div>
</article>

<style>
  .course {
    position: relative; display: grid; grid-template-rows: auto 1fr;
    background: var(--ink-2); color: var(--white); border: 1px solid var(--line-on-ink); border-radius: var(--radius); overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .course:hover { transform: translateY(-4px); border-color: var(--cyan); }
  .media { position: relative; aspect-ratio: 3 / 2; overflow: hidden; }
  .img { width: 100%; height: 100%; object-fit: cover; }
  .code, .free {
    position: absolute; top: 12px; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em;
    padding: 0.3rem 0.55rem; border-radius: 4px;
  }
  .code { left: 12px; top: auto; bottom: 12px; background: rgba(8, 19, 31, 0.85); color: var(--cyan); }
  .free { right: 12px; background: var(--amber); color: var(--ink); }
  .body { display: flex; flex-direction: column; gap: 0.7rem; padding: 1.3rem 1.3rem 1.5rem; }
  .status { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--amber); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 4px rgba(245, 183, 10, 0.2); }
  .title { font-size: 1.35rem; }
  .title a { text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .tag { color: var(--muted-on-ink); font-size: 0.95rem; }
  .mods { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.88rem; color: var(--muted-on-ink); }
  .more { margin-top: auto; display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--cyan); }
</style>

---
/**
 * Decorative crime-scene tape crossing a section boundary. Where the browser
 * supports scroll-driven animations the two bands slide as the page scrolls
 * (no JavaScript); elsewhere, and with reduced motion, they stay still.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;
const text = Array.from({ length: 8 }, () => 'Escena del crimen · No pasar ·').join(' ');
---
<div class:list={['tape', cls]} aria-hidden="true">
  <div class="band back"><span>{text}</span></div>
  <div class="band front"><span>{text}</span></div>
</div>

<style>
  .tape { position: relative; z-index: 4; height: 0; pointer-events: none; }
  .band {
    position: absolute; left: -5%; right: -5%; top: -22px; height: 44px; overflow: hidden;
    display: flex; align-items: center; white-space: nowrap;
    background: #f5c400; color: #0b0d10; box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.7);
    border-block: 4px solid #0b0d10;
    font-family: var(--font-mono); font-weight: 800; font-size: 0.95rem; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .front { transform: rotate(-2.2deg); }
  .back { transform: rotate(1.6deg); filter: brightness(0.82); }
  @media (max-width: 640px) { .band { height: 36px; top: -18px; font-size: 0.78rem; } }
  .band span { display: block; padding-left: 1rem; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .band span { animation: slide linear both; animation-timeline: view(); }
      .back span { animation-direction: reverse; }
    }
  }
  @keyframes slide { from { transform: translateX(0); } to { transform: translateX(-28%); } }
</style>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/utils';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE } from '../../data/site';

const posts = await getPosts();
const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Blog', path: '/blog/' }];
const listSchema = {
  '@type': 'Blog',
  name: 'Blog de AG Criminalística',
  url: `${SITE.url}/blog/`,
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${SITE.url}/${p.id}/` })),
};
---
<Base
  title="Blog de Criminalística y Ciencias Forenses"
  description="Artículos sobre criminalística, peritaje, cadena de custodia, informática forense y ciberseguridad en Ecuador. Conocimiento científico forense explicado con claridad."
  schema={[listSchema, breadcrumbSchema(crumbs)]}
>
  <PageHero
    label="Blog forense"
    title="Temas sobre ciencias forenses."
    lead="Te mantenemos informado sobre las diferentes áreas de la criminalística, el peritaje y la seguridad digital."
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container"><PostList posts={posts} /></div>
  </section>
</Base>

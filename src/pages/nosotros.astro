---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbSchema } from '../lib/schema';
import { SITE } from '../data/site';
import Fingerprint from '../components/Fingerprint.astro';
import logoGreen from '../assets/img/criminalistica-6.png';

const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Nosotros', path: '/nosotros/' }];
const person = {
  '@type': 'Person',
  name: 'Alberto Gutiérrez',
  honorificPrefix: 'Lcdo.',
  jobTitle: 'Licenciado en Criminalística',
  worksFor: { '@id': `${SITE.url}/#organization` },
  sameAs: [SITE.social.linkedin],
};
const values = [
  { icon: 'cap', t: 'Formación', d: 'Somos expertos en investigación forense y, además, contamos con las destrezas y competencias didácticas necesarias para dirigir procesos de enseñanza y formación de adultos profesionales.' },
  { icon: 'lightbulb', t: 'Innovación', d: 'Somos amigos de la tecnología y utilizamos todo el potencial de las herramientas digitales para innovar nuestros procesos de formación.' },
  { icon: 'users', t: 'Comunidad', d: 'Construimos una comunidad profesional para el intercambio de ideas y experiencias que impulsen el desarrollo de tu carrera, dentro de una red de contactos amplia y dinámica.' },
] as const;
---
<Base
  title="Nosotros: peritos criminalísticos en Ecuador"
  description="Conoce a AG Criminalística: equipo de expertos en criminalística dirigido por el Lcdo. Alberto Gutiérrez. Peritaje, reconstrucción 3D de hechos, consultoría y capacitación."
  schema={[person, breadcrumbSchema(crumbs)]}
>
  <PageHero
    label="Conócenos"
    title="La verdad, demostrada de forma técnica."
    lead="Peritaje criminalístico, reconstrucción 3D de los hechos, consultoría pericial y formación de peritos en todo Ecuador."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container two">
      <div class="copy">
        <p class="label cyan">Quiénes somos</p>
        <h2 class="h-section">Expertos comprometidos con la labor pericial.</h2>
        <p>
          Somos un equipo de expertos en el área de la criminalística y las ciencias forenses comprometidos con el
          desarrollo de la labor pericial a través de la capacitación, investigación y divulgación de conocimiento
          científico forense enfocado en el peritaje técnico profesional, la seguridad y la prevención del delito.
        </p>
        <p>
          Creamos un espacio para el intercambio de ideas y experiencia en el ámbito forense con el objetivo de crear
          una comunidad de expertos que colaboren con la justicia en la búsqueda de la verdad demostrada de forma
          técnica ante los tribunales. Estamos convencidos de que los casos se construyen a partir de los hechos, y
          que la investigación criminalística es el método que aporta las pruebas que los sustentan y determinan
          finalmente la norma jurídica aplicable.
        </p>
        <p>
          A través de nuestra oferta de formación profesional queremos potenciar tus recursos personales bajo un
          enfoque de competencias dinámicas que incorporen comprensión y acción a la vez. <strong>Saber pensar, saber ser y saber hacer</strong> es la premisa básica de
          nuestros procesos de formación.
        </p>
        <p>
          Hoy ponemos esa experiencia al servicio de abogados, instituciones y particulares con <a
            href="/servicios/peritaje-criminalistico/">peritajes criminalísticos</a>, <a
            href="/servicios/reconstruccion-3d-de-hechos/">reconstrucciones 3D de los hechos</a> y <a
            href="/servicios/consultoria-para-abogados/">consultoría pericial</a>.
        </p>
      </div>
      <figure class="logo-fig">
        <Image src={logoGreen} alt="Logotipo de AG Criminalística" widths={[320, 520]} sizes="(min-width: 900px) 420px, 80vw" class="logo-img" />
      </figure>
    </div>
  </section>

  <section class="section paper-2">
    <div class="container">
      <p class="label cyan">Nuestros valores</p>
      <h2 class="h-section">Tres pilares, un propósito.</h2>
      <ol class="values">
        {values.map((v, i) => (
          <li>
            <span class="marker">{i + 1}</span>
            <h3><Icon name={v.icon} size={22} /> {v.t}</h3>
            <p>{v.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section ink grid-bg">
    <div class="container two">
      <!-- Credential card (forensic ID style) in place of a photo. -->
      <div class="badge" aria-label="Credencial: Lcdo. Alberto Gutiérrez, Licenciado en Criminalística">
        <Fingerprint class="badge-fp" />
        <div class="badge-top">
          <span class="mono" aria-hidden="true">AG</span>
          <span class="badge-k">Credencial · Dirección académica</span>
        </div>
        <p class="badge-name">Lcdo. Alberto Gutiérrez</p>
        <p class="badge-role">Licenciado en Criminalística</p>
        <dl>
          <div><dt>Áreas</dt><dd>Peritaje · Reconstrucción 3D · Formación</dd></div>
          <div><dt>Cobertura</dt><dd>Todo Ecuador</dd></div>
          <div><dt>Colaboración</dt><dd>{SITE.partner}</dd></div>
        </dl>
      </div>
      <div class="copy">
        <p class="label cyan">Dirección académica</p>
        <h2 class="h-section">Lcdo. Alberto Gutiérrez</h2>
        <p>
          Licenciado en Criminalística, autor de los artículos de nuestro blog y divulgador de la investigación
          científica del delito: la investigación criminalística en Ecuador, la crisis carcelaria y el campo laboral
          del criminalista.
        </p>
        <p>
          AG Criminalística trabaja en colaboración con la empresa de consultoría y asesoramiento pericial <strong
            class="w">{SITE.partner}</strong>
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contacto/">Contáctanos <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={SITE.social.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .two { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .two { grid-template-columns: 1.2fr 0.8fr; } .ink .two { grid-template-columns: 0.8fr 1.2fr; } }
  .copy p + p { margin-top: 1rem; }
  .copy a:not(.btn) { color: var(--cyan-ink); font-weight: 600; }
  .copy > p:not(.label) { color: var(--muted); }
  .ink .copy > p:not(.label) { color: var(--muted-on-ink); }
  .ink h2 { color: var(--white); }
  .w { color: var(--white); }
  .copy .btn-row { margin-top: 1.5rem; }
  .logo-img { width: 100%; max-width: 420px; margin-inline: auto; border-radius: 20px; }
  .badge {
    position: relative; overflow: hidden; display: grid; gap: 0.35rem; max-width: 460px; width: 100%; margin-inline: auto;
    padding: 1.6rem 1.5rem 1.4rem; border-radius: 20px; color: var(--white);
    border: 1px solid transparent;
    background: linear-gradient(var(--ink-2), var(--ink-2)) padding-box, linear-gradient(135deg, var(--amber), rgba(255, 255, 255, 0.08) 55%, var(--amber)) border-box;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8);
  }
  .badge :global(.badge-fp) { position: absolute; right: -40px; bottom: -50px; width: 220px; color: var(--amber); opacity: 0.12; }
  .badge-top { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.8rem; }
  .mono {
    display: grid; place-items: center; width: 54px; height: 54px; border-radius: 14px; flex: none;
    font-weight: 900; font-size: 1.25rem; letter-spacing: -0.02em; color: var(--ink); background: var(--amber);
  }
  .badge-k { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cyan); }
  .badge-name { margin: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
  .badge-role { margin: 0 0 0.6rem; color: var(--muted-on-ink); }
  .badge dl { margin: 0; display: grid; gap: 0.5rem; padding-top: 0.9rem; border-top: 1px dashed rgba(255, 255, 255, 0.16); }
  .badge dl div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.6rem; }
  .badge dt { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-on-ink); padding-top: 0.15rem; }
  .badge dd { margin: 0; font-size: 0.93rem; }
  .values { list-style: none; padding: 0; display: grid; gap: 1.25rem; margin-top: 1.5rem; }
  @media (min-width: 900px) { .values { grid-template-columns: repeat(3, 1fr); } }
  .values li { display: grid; gap: 0.7rem; align-content: start; padding: 1.5rem; background: var(--paper); border-radius: var(--radius); border-top: 4px solid var(--cyan); }
  .values h3 { display: flex; gap: 0.5rem; align-items: center; font-size: 1.25rem; }
  .values p { color: var(--muted); }
</style>

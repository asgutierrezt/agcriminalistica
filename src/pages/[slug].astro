---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import AffiliateNote from '../components/AffiliateNote.astro';
import ReadMore from '../components/ReadMore.astro';
import TopPicks from '../components/TopPicks.astro';
import CompareTable from '../components/CompareTable.astro';
import TrustBox from '../components/TrustBox.astro';
import { pickFor } from '../data/library';
import { getPosts, formatDate, readingTime, type Post } from '../lib/utils';
import { breadcrumbSchema, ORG_ID } from '../lib/schema';
import { SITE, whatsappLink } from '../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props { post: Post; posts: Post[] }
const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const url = new URL(`/${post.id}/`, SITE.url).href;
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingTime(post.body);

// Curated reading for each article ("Para profundizar"); guides already link products inline.
const READING: Record<string, string[]> = {
  'cadena-de-custodia': ['fisher', 'bolsas-evidencia'],
  'cual-es-el-trabajo-de-un-perito': ['es-peritaje', 'saferstein'],
  'el-informe-pericial': ['es-peritaje', 'montiel-criminalistica'],
  'investigacion-pericial': ['montiel-criminalistica', 'fisher'],
  'investigacion-criminalistica': ['moreno-introduccion', 'rodriguez-criminologia'],
  dactiloscopia: ['es-dactiloscopia', 'kit-huellas'],
  feminicidios: ['geberth', 'bevel-gardner'],
  ciberseguridad: ['casey', 'saferstein'],
  'un-ciberataque-que-deberia-preocuparnos-a-todos': ['casey', 'bertino'],
  'privacidad-de-whatsapp': ['casey', 'bertino'],
};
const reading = d.affiliate ? [] : READING[post.id] ?? ['saferstein', 'montiel-criminalistica'];

// Next (older) article, wrapping around to the newest.
const next = posts[(posts.findIndex((p) => p.id === post.id) + 1) % posts.length];

const related = posts
  .filter((p) => p.id !== post.id && p.id !== next.id)
  .map((p) => ({ p, score: (p.data.category === d.category ? 2 : 0) + p.data.tags.filter((t) => d.tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((x) => x.p);

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: d.title, path: `/${post.id}/` },
];

const articleSchema = {
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: new URL(d.cover.src, SITE.url).href,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Person', name: d.author, url: `${SITE.url}/nosotros/` },
  publisher: { '@id': ORG_ID },
  mainEntityOfPage: url,
  articleSection: d.category,
  about: d.tags.map((name) => ({ '@type': 'Thing', name })),
  keywords: d.tags.join(', '),
  inLanguage: SITE.lang,
  wordCount: post.body?.split(/\s+/).length,
};

// Roundup guides: list the recommended books for search engines (no ratings or prices).
const listed = pickFor([...new Set([...d.picks, ...d.compare])]);
const itemListSchema = listed.length
  ? [{
      '@type': 'ItemList',
      name: d.title,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: listed.length,
      itemListElement: listed.map((it, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: it.cat === 'equipo'
          ? { '@type': 'Thing', name: it.title, description: it.why }
          : { '@type': 'Book', name: it.title, ...(it.author ? { author: { '@type': 'Person', name: it.author } } : {}), inLanguage: it.cat === 'en' ? 'en' : 'es' },
      })),
    }]
  : [];

const share = encodeURIComponent(url);
const shareText = encodeURIComponent(d.title);
---
<Base
  title={d.seoTitle ?? d.title}
  description={d.description}
  image={d.cover}
  imageAlt={d.coverAlt}
  type="article"
  published={d.pubDate}
  modified={d.updatedDate}
  schema={[articleSchema, breadcrumbSchema(crumbs), ...itemListSchema]}
  section={d.category}
  tags={d.tags}
  serif
>
  <ReadingProgress />
  <article data-article>
    <header class="post-hero ink grid-bg">
      <div class="narrow inner">
        <Breadcrumbs items={crumbs} />
        <p class="label cyan">{d.category}</p>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        <p class="meta">
          <span>Por <strong>{d.author}</strong></span>
          <span><time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time></span>
          {d.updatedDate && d.updatedDate > d.pubDate && (
            <span>Actualizado: <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time></span>
          )}
          <span><Icon name="clock" size={16} /> {minutes} min</span>
        </p>
      </div>
    </header>

    <div class="cover-wrap">
      <div class="narrow">
        <Image
          src={d.cover}
          alt={d.coverAlt}
          widths={[480, 760, 1080, 1520]}
          sizes="(min-width: 800px) 760px, 92vw"
          loading="eager"
          fetchpriority="high"
          class="cover"
        />
      </div>
    </div>

    <div class="narrow layout">
      {toc.length > 2 && (
        <nav class="toc" aria-label="Contenido del artículo">
          <details open>
            <summary>En este artículo</summary>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        </nav>
      )}

      {d.affiliate && <TrustBox updated={d.updatedDate ?? d.pubDate} />}
      {d.affiliate && <AffiliateNote />}
      {d.picks.length > 0 && <TopPicks ids={d.picks} />}

      <div class="prose">
        <Content />
      </div>

      {d.compare.length > 0 && <CompareTable ids={d.compare} />}

      {reading.length > 0 && <ReadMore ids={reading} />}

      <aside class="share" aria-label="Compartir">
        <span class="label">Compartir</span>
        <a href={`https://wa.me/?text=${shareText}%20${share}`} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp"><Icon name="whatsapp" /></a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener" aria-label="Compartir en Facebook"><Icon name="facebook" /></a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`} target="_blank" rel="noopener" aria-label="Compartir en LinkedIn"><Icon name="linkedin" /></a>
        <a href={`https://x.com/intent/post?url=${share}&text=${shareText}`} target="_blank" rel="noopener" aria-label="Compartir en X"><Icon name="x" /></a>
      </aside>

      <a class="next" href={`/${next.id}/`}>
        <span class="next-label">Siguiente artículo <Icon name="arrow" size={18} /></span>
        <span class="next-body">
          <Image src={next.data.cover} alt="" widths={[240, 400]} sizes="160px" class="next-img" />
          <span>
            <span class="next-cat">{next.data.category}</span>
            <strong>{next.data.title}</strong>
          </span>
        </span>
      </a>

      <section class="cta ink grid-bg">
        <p class="label cyan">¿Tienes un caso?</p>
        <h2>Prueba técnica que se entiende y se defiende.</h2>
        <p>Peritaje criminalístico, reconstrucción 3D de los hechos y consultoría para abogados en todo Ecuador.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/servicios/">Ver servicios <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
        </div>
      </section>
    </div>
  </article>

  <section class="section paper-2">
    <div class="container">
      <p class="label cyan">Sigue leyendo</p>
      <h2 class="h-section">Artículos relacionados</h2>
      <div class="related">
        {related.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .post-hero { padding-block: clamp(2.2rem, 1.5rem + 3vw, 4rem) clamp(6rem, 5rem + 5vw, 9rem); }
  .inner { display: grid; gap: 1rem; }
  h1 { font-size: clamp(2rem, 1.4rem + 2.8vw, 3.4rem); color: var(--white); letter-spacing: -0.03em; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; font-size: 0.88rem; color: var(--muted-on-ink); }
  .meta span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .meta strong { color: var(--white); }
  .cover-wrap { margin-top: clamp(-7.5rem, -4rem - 4vw, -5rem); }
  .cover { width: 100%; height: auto; border-radius: 16px; box-shadow: 0 30px 60px -30px rgba(14, 16, 19, 0.6); background: var(--paper-2); }
  .layout { display: grid; gap: 2rem; padding-block: 2.5rem 4rem; }

  .toc details { background: var(--white); border: 1px solid var(--line); border-left: 4px solid var(--amber); border-radius: 12px; padding: 1rem 1.2rem; }
  .toc summary { font-weight: 800; cursor: pointer; min-height: 32px; }
  .toc ol { margin-top: 0.6rem; padding-left: 1.2rem; display: grid; gap: 0.35rem; }
  .toc a { color: var(--cyan-ink); text-decoration: none; }
  .toc a:hover { text-decoration: underline; }

  .prose { font-family: var(--font-serif); font-size: clamp(1.08rem, 1rem + 0.3vw, 1.2rem); line-height: 1.75; color: #1b2733; }
  .prose :global(> * + *) { margin-top: 1.15em; }
  .prose :global(h2) { font-family: var(--font-sans); font-size: var(--step-2); margin-top: 2em; color: var(--ink); }
  .prose :global(h3) { font-family: var(--font-sans); font-size: var(--step-1); margin-top: 1.6em; color: var(--ink); }
  .prose :global(a) { color: var(--cyan-ink); text-decoration-thickness: 1.5px; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(li::marker) { color: var(--cyan-ink); font-weight: 700; }
  .prose :global(blockquote) {
    position: relative; margin-block: 2em; padding: 1.4rem 1.4rem 1.4rem 1.6rem;
    background: var(--ink); color: var(--white); border-radius: 14px; border-left: 6px solid var(--amber);
    font-family: var(--font-sans); font-size: 1.2rem; font-weight: 700; line-height: 1.4;
  }
  .prose :global(blockquote strong) { color: var(--white); }
  .prose :global(a.amz-link) {
    display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.2rem 0.75rem; border-radius: 999px;
    background: var(--amber); color: var(--ink); text-decoration: none; font-family: var(--font-sans); font-weight: 700; font-size: 0.88em;
  }
  .prose :global(a.amz-link::after) { content: '↗'; }
  .prose :global(a.amz-link:hover) { background: #ffc933; }
  .prose :global(img) { border-radius: 12px; margin-inline: auto; width: 100%; max-width: 560px; height: auto; }

  .share { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .share .label { margin-right: 0.5rem; color: var(--muted); }
  .share a { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--line); color: var(--ink); }
  .share a:hover { background: var(--ink); color: var(--white); }

  .next { display: grid; gap: 0.7rem; padding: 1.1rem; border-radius: 16px; text-decoration: none; background: var(--white); border: 1px solid var(--line); transition: border-color 0.2s ease, transform 0.2s ease; }
  .next:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .next-label { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cyan-ink); font-weight: 700; }
  .next-body { display: grid; grid-template-columns: 110px 1fr; gap: 1rem; align-items: center; }
  @media (min-width: 560px) { .next-body { grid-template-columns: 160px 1fr; } }
  .next-img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; }
  .next-cat { display: block; font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.25rem; }
  .next strong { font-size: 1.15rem; line-height: 1.25; color: var(--ink); }
  .cta { border-radius: 18px; padding: clamp(1.5rem, 1rem + 3vw, 2.5rem); display: grid; gap: 0.9rem; }
  .cta h2 { color: var(--white); font-size: var(--step-2); }
  .related { display: grid; gap: 1.25rem; }
  @media (min-width: 720px) { .related { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .related { grid-template-columns: repeat(3, 1fr); } }
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BulletHero from '../components/BulletHero.astro';
import SceneTour from '../components/SceneTour.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Process from '../components/Process.astro';
import PostCard from '../components/PostCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCourses, getPosts, getServices } from '../lib/utils';
import { FAQ } from '../data/faq';
import { whatsappLink } from '../data/site';
import { GLOSSARY } from '../data/glossary';
import scene3d from '../assets/img/escena-del-crimen-digital.jpg';

const services = await getServices();
const courses = await getCourses();
const posts = (await getPosts()).slice(0, 3);
const reco = services.find((s) => s.id === 'reconstruccion-3d-de-hechos')!;

const steps = [
  { t: 'Nos cuentas el caso', d: 'Por el formulario o WhatsApp. Toda consulta es confidencial.' },
  { t: 'Analizamos la evidencia', d: 'Revisamos el expediente, fotografías, informes y, si hace falta, el lugar.' },
  { t: 'Peritaje o reconstrucción', d: 'Aplicamos el método científico y modelamos los hechos en 3D cuando aporta.' },
  { t: 'Informe y audiencia', d: 'Entregamos informe y video, y los sustentamos ante el tribunal.' },
];

const audiences = [
  { icon: 'scale', t: 'Abogados y estudios jurídicos', d: 'Prueba técnica, contrapericia y preparación del interrogatorio.' },
  { icon: 'shield', t: 'Fiscalía y defensa', d: 'Análisis de la escena, indicios y cadena de custodia.' },
  { icon: 'building', t: 'Aseguradoras y empresas', d: 'Siniestros, accidentes laborales e investigaciones internas.' },
  { icon: 'users', t: 'Particulares y familias', d: 'Orientación técnica clara cuando más se necesita.' },
] as const;

// Service questions first, then general criminalistics ones.
const faq = [...services.map((s) => s.data.faq[0]), ...FAQ.slice(0, 4)];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="AG Criminalística | Peritaje y reconstrucción 3D en Ecuador"
  description="Peritos criminalísticos en Ecuador: reconstrucción 3D de los hechos, peritaje de parte y consultoría para abogados. Prueba técnica clara y defendible. Escríbenos."
  image={scene3d}
  imageAlt="Reconstrucción 3D de una escena del crimen"
  schema={[faqSchema]}
>
  <!-- HERO: cartucho 3D y balística (scroll) -->
  <BulletHero />

  <!-- SERVICIOS -->
  <section class="section" id="servicios">
    <div class="container">
      <div class="head split reveal">
        <div>
          <p class="label cyan">Servicios</p>
          <h2 class="h-section">Ciencia forense al servicio de tu caso.</h2>
        </div>
        <a class="btn btn-ghost" href="/servicios/">Todos los servicios <Icon name="arrow" /></a>
      </div>
      <div class="svc-grid">
        {services.map((s, i) => <ServiceCard service={s} featured={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- RECONSTRUCCIÓN 3D -->
  <section class="section ink grid-bg">
    <div class="container reco">
      <div class="reveal">
        <p class="label cyan">Reconstrucción 3D</p>
        <h2 class="h-section">Que el tribunal <span class="amber">vea</span> lo que ocurrió.</h2>
        <p class="lead">{reco.data.description}</p>
        <ul class="checks">
          {reco.data.benefits.map((b) => (
            <li><Icon name="check" size={20} /> <span><strong>{b.t}.</strong> {b.d}</span></li>
          ))}
        </ul>
        <a class="btn btn-primary" href="/servicios/reconstruccion-3d-de-hechos/">Conocer el servicio <Icon name="arrow" /></a>
      </div>
      <figure class="reco-fig reveal">
        <Image src={scene3d} alt="Ilustración de una reconstrucción digital de la escena del crimen con peritos analizando indicios" widths={[480, 760, 1080]} sizes="(min-width: 960px) 520px, 92vw" class="reco-img" />
        <figcaption>
          <span><Icon name="camera" size={16} /> Vista del testigo</span>
          <span><Icon name="cube" size={16} /> Vista cenital</span>
          <span><Icon name="crosshair" size={16} /> Trayectorias</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- RECORRIDO 3D (scroll) -->
  <SceneTour />

  <!-- PROCESO -->
  <section class="section paper-2">
    <div class="container">
      <div class="head reveal">
        <p class="label cyan">Cómo trabajamos</p>
        <h2 class="h-section">Del primer mensaje a la audiencia.</h2>
      </div>
      <Process steps={steps} />
    </div>
  </section>

  <!-- PARA QUIÉN -->
  <section class="section grid-bg-light">
    <div class="container">
      <div class="head reveal">
        <p class="label cyan">Para quién trabajamos</p>
        <h2 class="h-section">Prueba técnica para cada parte del proceso.</h2>
      </div>
      <ul class="aud">
        {audiences.map((a) => (
          <li class="reveal">
            <span class="aud-ic"><Icon name={a.icon} size={26} /></span>
            <h3>{a.t}</h3>
            <p>{a.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CAPACITACIÓN -->
  <section class="section ink" id="cursos">
    <div class="container">
      <div class="head split reveal">
        <div>
          <p class="label cyan">Capacitación</p>
          <h2 class="h-section">También formamos peritos.</h2>
          <p class="lead">Próximamente: cursos online de criminalística, informática forense e investigación del crimen. Aún sin fecha de inicio.</p>
        </div>
        <a class="btn btn-ghost" href="/cursos/">Ver capacitación <Icon name="arrow" /></a>
      </div>
      <ul class="course-list">
        {courses.map((c) => (
          <li>
            <a href={`/courses/${c.id}/`}>
              <span class="c-code">{c.data.code}</span>
              <span class="c-title">{c.data.title}</span>
              <span class="c-meta">{c.data.price === 'Gratis' ? 'Gratis · ' : ''}{c.data.status} · Online</span>
              <Icon name="arrow" size={20} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section paper-2">
    <div class="container">
      <div class="head split reveal">
        <div>
          <p class="label cyan">Blog forense</p>
          <h2 class="h-section">Publicaciones recientes.</h2>
        </div>
        <a class="btn btn-ghost" href="/blog/">Ir al blog <Icon name="arrow" /></a>
      </div>
      <div class="post-grid">
        {posts.map((p, i) => <PostCard post={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- SIGUE EXPLORANDO -->
  <section class="section grid-bg-light explore-sec">
    <div class="container">
      <div class="head reveal">
        <p class="label cyan">Sigue explorando</p>
        <h2 class="h-section">Aprende criminalística a tu ritmo.</h2>
      </div>
      <div class="explore">
        <a class="ex reveal" href="/servicios/reconstruccion-3d-de-hechos/">
          <span class="ex-ic"><Icon name="cube" size={28} /></span>
          <strong>Explora una escena en 3D</strong>
          <span>Cambia de vista, reproduce la secuencia, activa el luminol y descubre qué significa cada indicio.</span>
          <em>Abrir demostración →</em>
        </a>
        <a class="ex reveal" href="/glosario/">
          <span class="ex-ic"><Icon name="book" size={28} /></span>
          <strong>Glosario forense</strong>
          <span>{GLOSSARY.length} términos explicados: de la cadena de custodia a la trayectoria balística.</span>
          <em>Consultar glosario →</em>
        </a>
        <a class="ex reveal" href="/biblioteca/">
          <span class="ex-ic"><Icon name="fingerprint" size={28} /></span>
          <strong>Biblioteca forense</strong>
          <span>Los libros y el equipo que recomendamos para estudiar criminalística y practicar en casa.</span>
          <em>Ver recomendaciones →</em>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="preguntas">
    <div class="narrow">
      <div class="head reveal">
        <p class="label cyan">Preguntas frecuentes</p>
        <h2 class="h-section">Lo que más nos preguntan.</h2>
      </div>
      <div class="faq">
        {faq.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary><span class="q-n">{String(i + 1).padStart(2, '0')}</span><span class="q-t">{f.q}</span><span class="q-ic" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section ink grid-bg" id="contacto">
    <div class="container contact">
      <div class="reveal">
        <p class="label cyan">Contacto</p>
        <h2 class="h-section glitch" data-text="Cuéntanos tu caso.">Cuéntanos tu caso.</h2>
        <p class="lead">Evaluamos tu consulta sin compromiso. Respondemos de forma confidencial, en todo Ecuador.</p>
        <a class="btn btn-wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> Escribir por WhatsApp</a>
      </div>
      <div class="form-card reveal">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Shared section heads */
  .head { margin-bottom: 2.5rem; max-width: 720px; }
  .head.split { max-width: none; display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: flex-end; justify-content: space-between; }
  .head.split > div { max-width: 640px; }
  .ink .head h2, .reco h2, .contact h2 { color: var(--white); }

  /* SERVICES */
  .svc-grid, .post-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 720px) { .svc-grid, .post-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .svc-grid, .post-grid { grid-template-columns: repeat(3, 1fr); } }
  .course-list { list-style: none; padding: 0; border-top: 1px solid var(--line-on-ink); }
  .course-list li { border-bottom: 1px solid var(--line-on-ink); }
  .course-list a {
    display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: 'code title icon' 'code meta icon';
    gap: 0.15rem 1rem; align-items: center; padding: 1.1rem 0.25rem; text-decoration: none; color: var(--white);
    transition: background-color 0.2s ease, padding 0.2s ease;
  }
  .course-list a:hover { background: rgba(255, 255, 255, 0.04); padding-left: 0.75rem; }
  .course-list :global(svg) { grid-area: icon; color: var(--cyan); }
  .c-code { grid-area: code; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 800; color: var(--cyan); letter-spacing: 0.08em; }
  .c-title { grid-area: title; font-weight: 800; font-size: 1.12rem; line-height: 1.25; }
  .c-meta { grid-area: meta; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--amber); }
  @media (min-width: 900px) {
    .course-list a { grid-template-columns: 110px 1fr auto auto; grid-template-areas: 'code title meta icon'; padding-block: 1.3rem; }
  }

  /* RECONSTRUCTION */
  .reco { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 960px) { .reco { grid-template-columns: 1.05fr 0.95fr; gap: 4rem; } }
  .reco .lead { margin-bottom: 1.5rem; }
  .checks { list-style: none; padding: 0; display: grid; gap: 0.8rem; margin-bottom: 2rem; }
  .checks li { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--muted-on-ink); font-size: 0.97rem; }
  .checks strong { color: var(--white); }
  .checks :global(svg) { color: var(--amber); flex: none; margin-top: 3px; }
  .reco-fig { position: relative; margin: 0; }
  .reco-img { width: 100%; border-radius: 18px; border: 1px solid var(--line-on-ink); }
  .reco-fig figcaption { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.9rem; }
  .reco-fig figcaption span {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.7rem; border-radius: 999px;
    border: 1px solid var(--line-on-ink); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-on-ink);
  }

  /* AUDIENCES */
  .aud { list-style: none; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 720px) { .aud { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .aud { grid-template-columns: repeat(4, 1fr); } }
  .aud li { display: grid; gap: 0.6rem; align-content: start; padding: 1.5rem; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  .aud-ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 12px; background: var(--ink); color: var(--cyan); }
  .aud h3 { font-size: 1.12rem; }
  .aud p { color: var(--muted); font-size: 0.95rem; }

  /* EXPLORE */
  .explore { display: grid; gap: 1rem; }
  @media (min-width: 900px) { .explore { grid-template-columns: repeat(3, 1fr); } }
  .ex {
    display: grid; gap: 0.5rem; align-content: start; padding: 1.5rem; border-radius: var(--radius); text-decoration: none;
    background: var(--white); border: 1px solid var(--line); transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .ex:hover { transform: translateY(-3px); border-color: var(--cyan); box-shadow: 0 20px 40px -26px rgba(8, 19, 31, 0.5); }
  .ex-ic { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 14px; background: var(--ink); color: var(--amber); margin-bottom: 0.4rem; }
  .ex strong { font-size: 1.2rem; color: var(--ink); }
  .ex span:not(.ex-ic) { color: var(--muted); font-size: 0.95rem; }
  .ex em { font-style: normal; font-weight: 700; color: var(--cyan-ink); margin-top: 0.3rem; }

  /* FAQ */
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center;
    padding: 1.2rem 0; cursor: pointer; list-style: none; font-weight: 700; font-size: 1.1rem; min-height: 56px;
  }
  summary::-webkit-details-marker { display: none; }
  .q-n { font-family: var(--font-mono); font-size: 0.8rem; color: var(--cyan-ink); }
  .q-ic { position: relative; width: 22px; height: 22px; }
  .q-ic::before, .q-ic::after { content: ''; position: absolute; left: 3px; right: 3px; top: 10px; height: 2px; background: currentColor; transition: transform 0.2s ease; }
  .q-ic::after { transform: rotate(90deg); }
  details[open] .q-ic::after { transform: rotate(0deg); }
  details p { padding: 0 0 1.4rem 2.6rem; color: var(--muted); }
  @media (max-width: 480px) { details p { padding-left: 0; } }

  /* CONTACT */
  .contact { position: relative; display: grid; gap: 2.5rem; }
  @media (min-width: 960px) { .contact { grid-template-columns: 0.85fr 1.15fr; align-items: start; } }
  .btn-wa { margin-top: 1.8rem; background: #25d366; color: #062b14; }
  .btn-wa:hover { background: #3ddc7a; }
  .form-card :global(p) { color: inherit; }
  .form-card { background: var(--paper); color: var(--text); padding: clamp(1.25rem, 1rem + 2vw, 2.25rem); border-radius: 18px; }
</style>

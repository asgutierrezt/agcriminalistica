---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Fingerprint from '../components/Fingerprint.astro';
import CourseCard from '../components/CourseCard.astro';
import PostCard from '../components/PostCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCourses, getPosts } from '../lib/utils';
import { FAQ } from '../data/faq';
import { SITE, whatsappLink } from '../data/site';

import heroImg from '../assets/img/ciencias-forenses-laboratorio.jpg';
import estudiantes from '../assets/img/estudiantes.jpg';
import profesionales from '../assets/img/profesionales.jpg';
import empresas from '../assets/img/empresas-instituciones.jpg';
import manualDacti from '../assets/img/dactiloscopia.jpg';
import manualVoz from '../assets/img/identificacion-forense-voz.jpg';

const courses = await getCourses();
const posts = (await getPosts()).slice(0, 3);

const questions = [
  { n: 1, q: '¿Qué?', d: 'ocurrió' },
  { n: 2, q: '¿Dónde?', d: 'sucedió' },
  { n: 3, q: '¿Quién?', d: 'participó' },
  { n: 4, q: '¿Cómo?', d: 'se cometió' },
];

const pillars = [
  { icon: 'cap', t: 'Formación', d: 'Somos expertos en investigación forense y contamos con las competencias didácticas para dirigir procesos de enseñanza de adultos profesionales.' },
  { icon: 'lightbulb', t: 'Innovación', d: 'Aprovechamos todo el potencial de las herramientas digitales para innovar en nuestros procesos de formación.' },
  { icon: 'users', t: 'Comunidad', d: 'Construimos una red profesional para el intercambio de ideas y experiencias que impulsen tu carrera.' },
] as const;

const audiences = [
  { img: estudiantes, t: 'Estudiantes', d: 'Capacitación continua para iniciarte en la investigación técnico-científica del delito.', alt: 'Estudiante tomando un curso online de criminalística' },
  { img: profesionales, t: 'Profesionales', d: 'Formación para acreditarte como perito judicial ante el Consejo de la Judicatura.', alt: 'Profesional en formación pericial' },
  { img: empresas, t: 'Empresas e instituciones', d: 'Programas a medida en seguridad, prevención del delito e investigación interna.', alt: 'Capacitación para empresas e instituciones' },
];

const services = [
  { icon: 'cap', t: 'Capacitación forense', d: 'Cursos online en criminalística, informática forense e investigación del crimen.' },
  { icon: 'scale', t: 'Consultoría pericial', d: `Asesoramiento técnico en procesos judiciales junto a ${SITE.partner}` },
  { icon: 'search', t: 'Investigación y divulgación', d: 'Creamos y compartimos conocimiento científico forense para una sociedad más segura y justa.' },
] as const;

const perks = [
  { icon: 'chat', t: 'Seguimiento académico', d: 'Tutorías programadas para resolver dudas e inquietudes.' },
  { icon: 'book', t: 'Biblioteca online', d: 'Bibliografía digital en todas las áreas de las ciencias forenses.' },
  { icon: 'users', t: 'Comunidad', d: 'Intercambia experiencias con alumnos y profesionales del área.' },
] as const;

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="AG Criminalística | Cursos de Criminalística y Formación de Peritos en Ecuador"
  description="Escuela online de criminalística y ciencias forenses en Ecuador. Cursos para la formación de peritos, informática forense e investigación del crimen. Solicita información."
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="hero ink grid-bg">
    <Fingerprint class="hero-fp" />
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="label cyan">Escuela online de criminalística · Ecuador</p>
        <h1 class="h-display">
          Formamos peritos que <span class="hl">demuestran la verdad</span> con ciencia.
        </h1>
        <p class="lead">
          Capacitación, investigación y consultoría en criminalística y ciencias forenses para estudiantes,
          profesionales e instituciones que colaboran con la justicia.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/cursos/">Ver cursos <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={whatsappLink('Hola, quisiera información sobre los cursos de AG Criminalística.')} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Hablar por WhatsApp
          </a>
        </div>
      </div>
      <figure class="hero-figure">
        <div class="frame">
          <Image
            src={heroImg}
            alt="Perito forense analizando evidencia en un microscopio de laboratorio"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1000px) 520px, 92vw"
            loading="eager"
            fetchpriority="high"
            class="hero-img"
          />
          <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
        </div>
        <figcaption class="case-tag">
          <span class="marker" style="--s:38px">1</span>
          <span><strong>Evidencia</strong><br />Método científico aplicado al delito</span>
        </figcaption>
      </figure>
    </div>
    <div class="container">
      <ol class="questions" aria-label="Las cuatro preguntas de la criminalística">
        {questions.map((x) => (
          <li><span class="marker" style="--s:34px">{x.n}</span><span><strong>{x.q}</strong> {x.d}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- NOSOTROS -->
  <section class="section grid-bg-light" id="nosotros">
    <div class="container about">
      <div class="reveal">
        <p class="label cyan">Conócenos</p>
        <h2 class="h-section">Ciencia forense al servicio de la justicia.</h2>
        <p class="lead">
          Somos un equipo de expertos en criminalística y ciencias forenses comprometidos con el desarrollo de la
          labor pericial a través de la capacitación, la investigación y la divulgación del conocimiento científico.
        </p>
        <p class="about-p">
          Estamos convencidos de que los casos se construyen a partir de los hechos, y que la investigación
          criminalística es el método que aporta las pruebas que los sustentan. Nuestra premisa formativa:
          <strong>saber pensar, saber ser y saber hacer.</strong>
        </p>
        <a class="link-arrow" href="/nosotros/">Conoce más sobre nosotros <Icon name="arrow" size={18} /></a>
      </div>
      <ol class="pillars">
        {pillars.map((p, i) => (
          <li class="pillar reveal">
            <span class="marker square">{i + 1}</span>
            <div>
              <h3><Icon name={p.icon} size={22} /> {p.t}</h3>
              <p>{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section paper-2" id="servicios">
    <div class="container">
      <div class="head reveal">
        <p class="label cyan">Criminalística al servicio de</p>
        <h2 class="h-section">Un programa para cada etapa de tu carrera.</h2>
      </div>
      <div class="audiences">
        {audiences.map((a, i) => (
          <article class="aud reveal">
            <Image src={a.img} alt={a.alt} widths={[360, 540, 720]} sizes="(min-width: 900px) 30vw, 92vw" class="aud-img" />
            <div class="aud-body">
              <span class="aud-n">0{i + 1}</span>
              <h3>{a.t}</h3>
              <p>{a.d}</p>
            </div>
          </article>
        ))}
      </div>
      <ul class="services">
        {services.map((s) => (
          <li class="reveal">
            <span class="svc-icon"><Icon name={s.icon} size={26} /></span>
            <div><h3>{s.t}</h3><p>{s.d}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CURSOS -->
  <section class="section ink grid-bg" id="cursos">
    <div class="container">
      <div class="head split reveal">
        <div>
          <p class="label cyan">Nuestros cursos</p>
          <h2 class="h-section">Programas de capacitación en ciencias forenses.</h2>
        </div>
        <a class="btn btn-ghost" href="/cursos/">Todos los cursos <Icon name="arrow" /></a>
      </div>
      <div class="course-grid">
        {courses.map((c) => <CourseCard course={c} />)}
      </div>
      <ul class="perks">
        {perks.map((p) => (
          <li class="reveal"><Icon name={p.icon} size={26} class="perk-ic" /><div><h3>{p.t}</h3><p>{p.d}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- MANUALES -->
  <section class="section">
    <div class="container">
      <div class="head reveal">
        <p class="label cyan">Recursos gratuitos</p>
        <h2 class="h-section">Manuales para empezar hoy.</h2>
      </div>
      <div class="manuals">
        <a class="manual reveal" href="/manual-dactiloscopia/">
          <Image src={manualDacti} alt="Portada del manual de dactiloscopia" widths={[360, 640]} sizes="(min-width: 800px) 40vw, 92vw" class="manual-img" />
          <div><p class="label">Manual · PDF</p><h3>Identificación humana: dactiloscopia</h3><span class="link-arrow">Solicitar gratis <Icon name="download" size={18} /></span></div>
        </a>
        <a class="manual reveal" href="/manual-identificacion-forense-de-la-voz/">
          <Image src={manualVoz} alt="Portada del manual de identificación forense de la voz" widths={[360, 640]} sizes="(min-width: 800px) 40vw, 92vw" class="manual-img" />
          <div><p class="label">Manual · PDF</p><h3>Identificación forense de la voz</h3><span class="link-arrow">Solicitar gratis <Icon name="download" size={18} /></span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section paper-2">
    <div class="container">
      <div class="head split reveal">
        <div>
          <p class="label cyan">Actualidad</p>
          <h2 class="h-section">Publicaciones recientes.</h2>
        </div>
        <a class="btn btn-ghost" href="/blog/">Ir al blog <Icon name="arrow" /></a>
      </div>
      <div class="post-grid">
        {posts.map((p, i) => <PostCard post={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="preguntas">
    <div class="narrow">
      <div class="head reveal">
        <p class="label cyan">Preguntas frecuentes</p>
        <h2 class="h-section">Lo que todo futuro perito pregunta.</h2>
      </div>
      <div class="faq">
        {FAQ.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary><span class="q-n">{String(i + 1).padStart(2, '0')}</span><span class="q-t">{f.q}</span><span class="q-ic" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section ink grid-bg" id="contacto">
    <div class="container contact">
      <div class="reveal">
        <p class="label cyan">Solicitar información</p>
        <h2 class="h-section">Da el siguiente paso en tu carrera forense.</h2>
        <p class="lead">Escríbenos y te enviaremos fechas, modalidad y costos. Respondemos personalmente cada mensaje.</p>
        <ul class="contact-list">
          <li><a href={whatsappLink('Hola AG Criminalística')} target="_blank" rel="noopener"><Icon name="whatsapp" /> {SITE.phoneDisplay}</a></li>
          <li><a href={`mailto:${SITE.email}`}><Icon name="mail" /> {SITE.email}</a></li>
          <li><a href={SITE.social.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> @agcriminalistica</a></li>
        </ul>
      </div>
      <div class="form-card reveal">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) 2rem; }
  .hero :global(.hero-fp) { position: absolute; left: -90px; bottom: -60px; width: min(70vw, 420px); color: var(--cyan); opacity: 0.08; }
  .hero-grid { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1.15fr 0.85fr; gap: 4rem; } }
  .hero-copy { display: grid; gap: 1.4rem; }
  .hero h1 { color: var(--white); }
  .hero-figure { position: relative; }
  .frame { position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 4 / 3.4; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; object-position: 70% center; filter: saturate(0.9) contrast(1.05); }
  .frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(8, 19, 31, 0.55)); }
  .corner { position: absolute; width: 26px; height: 26px; border: 3px solid var(--amber); z-index: 1; }
  .tl { top: 12px; left: 12px; border-right: 0; border-bottom: 0; }
  .tr { top: 12px; right: 12px; border-left: 0; border-bottom: 0; }
  .bl { bottom: 12px; left: 12px; border-right: 0; border-top: 0; }
  .br { bottom: 12px; right: 12px; border-left: 0; border-top: 0; }
  .case-tag {
    position: absolute; left: -8px; bottom: -22px; display: flex; gap: 0.8rem; align-items: center;
    background: var(--white); color: var(--ink); padding: 0.8rem 1.1rem 0.8rem 0.8rem; border-radius: 12px;
    font-size: 0.85rem; line-height: 1.3; box-shadow: 0 20px 40px -18px rgba(0, 0, 0, 0.6); max-width: 290px;
  }
  @media (min-width: 1000px) { .case-tag { left: -40px; } }
  .questions {
    list-style: none; padding: 0; margin-top: 4rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: var(--line-on-ink); border: 1px solid var(--line-on-ink); border-radius: 14px; overflow: hidden;
  }
  @media (min-width: 800px) { .questions { grid-template-columns: repeat(4, 1fr); } }
  .questions li { display: flex; align-items: center; gap: 0.8rem; padding: 1rem; background: var(--ink); color: var(--muted-on-ink); font-size: 0.95rem; }
  .questions strong { color: var(--white); font-size: 1.1rem; }

  /* Shared section heads */
  .head { margin-bottom: 2.5rem; max-width: 720px; }
  .head.split { max-width: none; display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: flex-end; justify-content: space-between; }
  .head.split > div { max-width: 640px; }
  .link-arrow { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--cyan-ink); text-decoration: none; }
  .link-arrow:hover { text-decoration: underline; }

  /* ABOUT */
  .about { display: grid; gap: 3rem; }
  @media (min-width: 960px) { .about { grid-template-columns: 1.1fr 0.9fr; align-items: center; } }
  .about-p { margin-block: 1rem 1.5rem; color: var(--muted); max-width: 60ch; }
  .pillars { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .pillar { display: flex; gap: 1rem; padding: 1.3rem; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  .pillar h3 { display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; margin-bottom: 0.35rem; }
  .pillar p { color: var(--muted); font-size: 0.95rem; }

  /* AUDIENCES & SERVICES */
  .audiences { display: grid; gap: 1.25rem; }
  @media (min-width: 900px) { .audiences { grid-template-columns: repeat(3, 1fr); } }
  .aud { position: relative; border-radius: var(--radius); overflow: hidden; min-height: 380px; display: flex; align-items: flex-end; color: var(--white); }
  .aud-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .aud::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8, 19, 31, 0) 25%, rgba(8, 19, 31, 0.92) 78%); }
  .aud-body { position: relative; z-index: 1; padding: 1.5rem; }
  .aud-n { font-family: var(--font-mono); color: var(--amber); font-weight: 800; }
  .aud h3 { font-size: 1.5rem; margin-block: 0.3rem 0.4rem; }
  .aud p { color: #d5dee7; font-size: 0.95rem; }
  .services { list-style: none; padding: 0; margin-top: 2.5rem; display: grid; gap: 1rem; }
  @media (min-width: 900px) { .services { grid-template-columns: repeat(3, 1fr); } }
  .services li { display: flex; gap: 1rem; padding: 1.3rem; border-top: 3px solid var(--ink); background: var(--paper); }
  .svc-icon { display: grid; place-items: center; width: 52px; height: 52px; flex: none; border-radius: 12px; background: var(--ink); color: var(--cyan); }
  .services h3 { font-size: 1.12rem; margin-bottom: 0.3rem; }
  .services p { color: var(--muted); font-size: 0.95rem; }

  /* COURSES */
  .course-grid, .post-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 720px) { .course-grid, .post-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .course-grid, .post-grid { grid-template-columns: repeat(3, 1fr); } }
  .perks { list-style: none; padding: 0; margin-top: 3rem; display: grid; gap: 1.5rem; border-top: 1px solid var(--line-on-ink); padding-top: 2.5rem; }
  @media (min-width: 800px) { .perks { grid-template-columns: repeat(3, 1fr); } }
  .perks li { display: flex; gap: 1rem; }
  .perks :global(.perk-ic) { color: var(--amber); flex: none; }
  .perks h3 { font-size: 1.1rem; color: var(--white); margin-bottom: 0.25rem; }
  .perks p { font-size: 0.95rem; }

  /* MANUALS */
  .manuals { display: grid; gap: 1.25rem; }
  @media (min-width: 800px) { .manuals { grid-template-columns: 1fr 1fr; } }
  .manual {
    display: grid; grid-template-columns: 120px 1fr; gap: 1.2rem; align-items: center; padding: 1rem;
    text-decoration: none; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .manual:hover { border-color: var(--cyan); transform: translateY(-2px); }
  @media (min-width: 480px) { .manual { grid-template-columns: 170px 1fr; } }
  .manual-img { width: 100%; aspect-ratio: 1; object-fit: contain; background: var(--white); border-radius: 10px; }
  .manual h3 { font-size: 1.2rem; margin-block: 0.4rem 0.6rem; }
  .manual .label { color: var(--muted); }

  /* FAQ */
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center;
    padding: 1.2rem 0; cursor: pointer; list-style: none; font-weight: 700; font-size: 1.12rem; min-height: 56px;
  }
  summary::-webkit-details-marker { display: none; }
  .q-n { font-family: var(--font-mono); font-size: 0.8rem; color: var(--cyan-ink); }
  .q-ic { position: relative; width: 22px; height: 22px; }
  .q-ic::before, .q-ic::after { content: ''; position: absolute; left: 3px; right: 3px; top: 10px; height: 2px; background: currentColor; transition: transform 0.2s ease; }
  .q-ic::after { transform: rotate(90deg); }
  details[open] .q-ic::after { transform: rotate(0deg); }
  details p { padding: 0 0 1.4rem 2.6rem; color: var(--muted); }
  @media (max-width: 480px) { details p { padding-left: 0; } }

  /* CONTACT */
  .contact { display: grid; gap: 2.5rem; }
  @media (min-width: 960px) { .contact { grid-template-columns: 0.85fr 1.15fr; align-items: start; } }
  .contact h2 { color: var(--white); }
  .contact-list { list-style: none; padding: 0; margin-top: 1.8rem; display: grid; gap: 0.5rem; }
  .contact-list a { display: inline-flex; align-items: center; gap: 0.75rem; min-height: 44px; color: var(--white); text-decoration: none; font-weight: 600; word-break: break-word; }
  .contact-list a:hover { color: var(--cyan); }
  .form-card :global(p) { color: inherit; }
  .form-card { background: var(--paper); color: var(--text); padding: clamp(1.25rem, 1rem + 2vw, 2.25rem); border-radius: 18px; }
</style>

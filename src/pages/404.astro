---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PostList from '../components/PostList.astro';
import Icon from '../components/Icon.astro';
import { getPosts } from '../lib/utils';
const posts = (await getPosts()).slice(0, 3);
---
<Base title="Página no encontrada" description="La página que buscas no existe o fue movida." noindex>
  <PageHero label="Error 404 · Sin evidencia" title="Esta escena está vacía." lead="La página que buscas no existe o fue movida. Te dejamos algunas pistas para continuar." crumbs={[{ name: 'Inicio', path: '/' }, { name: '404', path: '/404/' }]}>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Ir al inicio <Icon name="arrow" /></a>
      <a class="btn btn-ghost" href="/cursos/">Ver cursos</a>
      <a class="btn btn-ghost" href="/blog/">Leer el blog</a>
    </div>
  </PageHero>
  <section class="section">
    <div class="container"><PostList posts={posts} /></div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE, whatsappLink } from '../../data/site';

const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Contacto', path: '/contacto/' }];
const contactPage = { '@type': 'ContactPage', name: 'Contacto AG Criminalística', url: `${SITE.url}/contacto/` };
const channels = [
  { icon: 'whatsapp', t: 'WhatsApp', v: 'Respuesta rápida', href: whatsappLink(), ext: true },
  { icon: 'instagram', t: 'Instagram', v: '@agcriminalistica', href: SITE.social.instagram, ext: true },
  { icon: 'facebook', t: 'Facebook', v: '/agcriminalistica', href: SITE.social.facebook, ext: true },
  { icon: 'linkedin', t: 'LinkedIn', v: 'Alberto Gutiérrez', href: SITE.social.linkedin, ext: true },
] as const;
---
<Base
  title="Contacto: solicita un peritaje o reconstrucción 3D"
  description="Cuéntanos tu caso: peritaje criminalístico, reconstrucción 3D de los hechos, consultoría para abogados o cursos. Respondemos por WhatsApp o correo en todo Ecuador."
  schema={[contactPage, breadcrumbSchema(crumbs)]}
>
  <PageHero
    label="Contacto"
    title="Cuéntanos tu caso."
    lead="Escríbenos por el formulario o por WhatsApp. Tu consulta es confidencial y la responde directamente un especialista."
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container layout">
      <div class="form-card">
        <h2>Envíanos un mensaje</h2>
        <ContactForm />
      </div>
      <aside>
        <h2 class="side-title">Otros canales</h2>
        <a class="btn btn-wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> Escribir por WhatsApp</a>
        <ul class="channels">
          {channels.map((c) => (
            <li>
              <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>
                <span class="ic"><Icon name={c.icon} /></span>
                <span><small>{c.t}</small>{c.v}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="note"><Icon name="shield" size={18} /> Consultas confidenciales · Atención en todo Ecuador.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; gap: 2.5rem; }
  @media (min-width: 960px) { .layout { grid-template-columns: 1.4fr 0.8fr; align-items: start; } }
  .form-card { background: var(--white); border: 1px solid var(--line); border-radius: 18px; padding: clamp(1.25rem, 1rem + 2vw, 2.25rem); }
  h2 { font-size: var(--step-2); margin-bottom: 1.25rem; }
  .side-title { font-size: var(--step-1); }
  .btn-wa { width: 100%; background: #25d366; color: #062b14; margin-bottom: 1rem; }
  .btn-wa:hover { background: #3ddc7a; }
  .channels { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .channels a { display: flex; gap: 0.9rem; align-items: center; padding: 0.8rem; border-radius: 12px; text-decoration: none; border: 1px solid var(--line); background: var(--white); word-break: break-word; }
  .channels a:hover { border-color: var(--cyan); }
  .ic { display: grid; place-items: center; width: 46px; height: 46px; flex: none; border-radius: 10px; background: var(--ink); color: var(--cyan); }
  small { display: block; font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .note { display: flex; gap: 0.5rem; align-items: center; margin-top: 1.25rem; color: var(--muted); font-size: 0.92rem; }
</style>

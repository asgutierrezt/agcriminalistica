---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Contacto', path: '/contacto/' }, { name: 'Mensaje enviado', path: '/contacto/gracias/' }];
---
<Base title="Mensaje enviado" description="Gracias por escribir a AG Criminalística. Te responderemos muy pronto." noindex>
  <PageHero label="Mensaje recibido" title="¡Gracias por escribirnos!" lead="Recibimos tu mensaje y te responderemos muy pronto a tu correo o WhatsApp." crumbs={crumbs}>
    <div class="btn-row">
      <a class="btn btn-primary" href="/blog/">Leer el blog <Icon name="arrow" /></a>
      <a class="btn btn-ghost" href="/">Volver al inicio</a>
    </div>
  </PageHero>
</Base>
